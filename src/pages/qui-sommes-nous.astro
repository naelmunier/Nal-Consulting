    border: 2px solid var(--bleu);
    border-radius: 50%;
    animation: ring-pulse-clair 2.4s ease-in-out infinite;
  }
  @keyframes ring-pulse-clair {
    0%, 100% { box-shadow: 0 0 0 0 rgba(160, 180, 222, 0.55); }
    50%      { box-shadow: 0 0 0 12px rgba(160, 180, 222, 0); }
  }
  .parcours-step__core {
    position: absolute;
    inset: 7px;
    background: linear-gradient(135deg, var(--bleu), var(--bleu-clair));
    border-radius: 50%;
    box-shadow: 0 0 18px rgba(160, 180, 222, 0.7);
  }

  .parcours-step__contenu {
    background: rgba(160, 180, 222, 0.05);
    border: 1px solid rgba(160, 180, 222, 0.18);
    backdrop-filter: blur(8px);
    border-radius: var(--rayon-lg);
    padding: 1.6rem 1.8rem;
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease;
  }
  .parcours-step__contenu:hover {
    transform: translateX(8px);
    border-color: rgba(160, 180, 222, 0.4);
    background: rgba(160, 180, 222, 0.08);
    box-shadow: 0 12px 40px rgba(13, 24, 48, 0.4);
  }

  .parcours-step__year {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bleu);
    margin-bottom: 0.4rem;
  }
  .parcours-step__titre {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--blanc);
    margin-bottom: 0.4rem;
  }
  .parcours-step__texte {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(200, 216, 240, 0.75);
  }

  /* ═══════════════════════════════════════════
     CTA FINAL
     ═══════════════════════════════════════════ */
  .cta-final {
    position: relative;
    padding: 8rem 0;
    background: linear-gradient(135deg, #0d1830 0%, #1a2e50 50%, #2a4577 100%);
    overflow: hidden;
  }
  .cta-final__halo {
    position: absolute;
    width: 800px;
    height: 800px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(160, 180, 222, 0.18), transparent 65%);
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  .cta-final__inner {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  .cta-final__titre {
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--bleu-clair);
    margin-bottom: 2.6rem;
  }
  .cta-final__shimmer {
    background: linear-gradient(100deg, #c8d8f0, #ffffff 40%, #A0B4DE 60%, #c8d8f0);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: shimmer-flow 5s ease-in-out infinite;
  }
  .cta-final__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════ */
  @media (max-width: 900px) {
    .piliers-grille { grid-template-columns: 1fr; gap: 1.4rem; }
    .piliers-fil { display: none; }
    .piliers-bonus__inner { flex-direction: column; padding: 2rem; gap: 1.4rem; text-align: center; }
    .piliers-bonus__texte { align-items: center; }
  }
  @media (max-width: 640px) {
    .chapitre { padding: 6rem 0; }
    .manifeste-narration__para { font-size: 1.2rem; }
    .acte__titre { font-size: clamp(1.6rem, 7vw, 2.4rem); }
    .engagements-grille { grid-template-columns: 1fr; }
  }
</style>

<svg width="0" height="0" style="position: absolute;">
  <defs>
    <linearGradient id="trace-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6B91D4" stop-opacity="0" />
      <stop offset="50%" stop-color="#6B91D4" stop-opacity="1" />
      <stop offset="100%" stop-color="#A0B4DE" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="jauge-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#A0B4DE" />
      <stop offset="100%" stop-color="#4a70c0" />
    </linearGradient>
    <radialGradient id="orbe-grad" cx="35%" cy="35%" r="65%">
      <stop offset="0%"   stop-color="#c8d8f0" />
      <stop offset="55%"  stop-color="#6B91D4" />
      <stop offset="100%" stop-color="#4a70c0" />
    </radialGradient>
    <linearGradient id="barre-grad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%"   stop-color="#4a70c0" />
      <stop offset="60%"  stop-color="#6B91D4" />
      <stop offset="100%" stop-color="#A0B4DE" />
    </linearGradient>
  </defs>
</svg>

<script>
  // Split words pour reveal en cascade
  function splitIntoWords(el: HTMLElement) {
    if (el.dataset.split === '1') return;
    const text = el.dataset.words ?? el.textContent ?? '';
    el.textContent = '';
    const words = text.split(/(\s+)/);
    words.forEach((w) => {
      if (/^\s+$/.test(w)) {
        el.appendChild(document.createTextNode(w));
      } else if (w.length) {
        const span = document.createElement('span');
        span.className = 'word';
        span.textContent = w;
        el.appendChild(span);
      }
    });
    el.dataset.split = '1';
  }

  // Initialise tous les titres à split
  const titres = document.querySelectorAll<HTMLElement>('.titre-words, .word-line');
  titres.forEach(splitIntoWords);

  // Cascade au scroll pour les titres-words
  const titresObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        if (el.dataset.revealed === '1') return;
        el.dataset.revealed = '1';
        const words = el.querySelectorAll<HTMLElement>('.word');
        words.forEach((w, i) => {
          setTimeout(() => w.classList.add('is-revealed'), i * 70);
        });
        titresObs.unobserve(el);
      });
    },
    { threshold: 0.3, rootMargin: '0px 0px -40px 0px' }
  );
  titres.forEach((t) => titresObs.observe(t));

  // Reveal-fade & reveal-paragraph & reveal-pilier
  const fadeEls = document.querySelectorAll<HTMLElement>(
    '.reveal-fade, .reveal-paragraph, .reveal-pilier'
  );
  const fadeObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-revealed');
        fadeObs.unobserve(e.target);
      });
    },
    { threshold: 0.18, rootMargin: '0px 0px -40px 0px' }
  );
  fadeEls.forEach((el) => fadeObs.observe(el));

  // Animation Hero immédiate au chargement
  window.addEventListener('load', () => {
    const heroLines = document.querySelectorAll<HTMLElement>('.manifeste-titre__line');
    heroLines.forEach((line, lineIdx) => {
      const words = line.querySelectorAll<HTMLElement>('.word');
      words.forEach((w, i) => {
        setTimeout(
          () => w.classList.add('is-revealed'),
          200 + lineIdx * 350 + i * 80
        );
      });
      (line as HTMLElement).dataset.revealed = '1';
    });
  });
</script>

