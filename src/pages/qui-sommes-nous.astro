---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Notre Histoire — Nal Consulting">

  {/* ═══════════════════════════════════════════
       CHAPITRE I — OUVERTURE
       ═══════════════════════════════════════════ */}
  <section class="chapitre chapitre--ouverture">
    <div class="aurora aurora--1" aria-hidden="true"></div>
    <div class="aurora aurora--2" aria-hidden="true"></div>
    <div class="aurora aurora--3" aria-hidden="true"></div>
    <div class="grid-soft" aria-hidden="true"></div>

    <div class="container chapitre__container">
      <span class="kicker reveal-fade">— Notre histoire</span>

      <h1 class="manifeste-titre">
        <span class="manifeste-titre__line titre-words" data-words="Le partenaire tech"></span>
        <span class="manifeste-titre__line manifeste-titre__line--shimmer titre-words" data-words="qui s'engage à vos côtés."></span>
      </h1>

      <div class="manifeste-trace reveal-fade" aria-hidden="true">
        <svg viewBox="0 0 200 8" preserveAspectRatio="none">
          <line x1="0" y1="4" x2="200" y2="4" class="manifeste-trace__line" />
        </svg>
      </div>

      <p class="manifeste-intro titre-words" data-words="Une exigence simple. Livrer ce qui crée de la valeur."></p>
    </div>

    <div class="chapitre__scroll" aria-hidden="true">
      <span class="chapitre__scroll-label">défiler</span>
      <span class="chapitre__scroll-line"></span>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
       CHAPITRE II — LE MANIFESTE & LES ENGAGEMENTS
       ═══════════════════════════════════════════ */}
  <section class="chapitre chapitre--manifeste">
    <div class="manifeste-blob manifeste-blob--1" aria-hidden="true"></div>
    <div class="manifeste-blob manifeste-blob--2" aria-hidden="true"></div>

    <div class="container">
      <div class="engagements-intro">
        <span class="kicker kicker--center reveal-fade">— Nos engagements</span>
        <h2 class="acte__titre titre-words" data-words="Quatre promesses,"></h2>
        <h2 class="acte__titre acte__titre--shimmer titre-words" data-words="tenues sur chaque projet."></h2>
      </div>

      <div class="engagements-grille">
        <article class="engagement-carte reveal-pilier" style="--delay: 0ms;">
          <div class="engagement-carte__num">01</div>
          <div class="engagement-carte__icone-wrap" aria-hidden="true">
            <div class="engagement-carte__icone-halo"></div>
            <img src="/assets/quality/confiance.gif" alt="" class="engagement-carte__icone-img" />
          </div>
          <h3 class="engagement-carte__titre">Engagement</h3>
          <p class="engagement-carte__texte">Livraison dans les délais. Pas de mises en demeure. Pas d'excuses.</p>
        </article>

        <article class="engagement-carte reveal-pilier" style="--delay: 90ms;">
          <div class="engagement-carte__num">02</div>
          <div class="engagement-carte__icone-wrap" aria-hidden="true">
            <div class="engagement-carte__icone-halo"></div>
            <img src="/assets/quality/excellence.png" alt="" class="engagement-carte__icone-img" />
          </div>
          <h3 class="engagement-carte__titre">Excellence</h3>
          <p class="engagement-carte__texte">Code propre, documenté, testé. Conçu pour durer et évoluer.</p>
        </article>

        <article class="engagement-carte reveal-pilier" style="--delay: 180ms;">
          <div class="engagement-carte__num">03</div>
          <div class="engagement-carte__icone-wrap" aria-hidden="true">
            <div class="engagement-carte__icone-halo"></div>
            <img src="/assets/quality/vision-claire.png" alt="" class="engagement-carte__icone-img" />
          </div>
          <h3 class="engagement-carte__titre">Vision stratégique</h3>
          <p class="engagement-carte__texte">Chaque livrable sert un objectif business. Jamais l'inverse.</p>
        </article>

        <article class="engagement-carte reveal-pilier" style="--delay: 270ms;">
          <div class="engagement-carte__num">04</div>
          <div class="engagement-carte__icone-wrap" aria-hidden="true">
            <div class="engagement-carte__icone-halo"></div>
            <img src="/assets/quality/flexibility.png" alt="" class="engagement-carte__icone-img" />
          </div>
          <h3 class="engagement-carte__titre">Flexibilité</h3>
          <p class="engagement-carte__texte">Aucun engagement de longue durée imposé. Vous restez libre.</p>
        </article>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
       CHAPITRE III — TROIS PILIERS DE CONFIANCE
       Indépendance · Transparence · Résultat
       ═══════════════════════════════════════════ */}
  <section class="chapitre chapitre--piliers">
    <div class="piliers-bg" aria-hidden="true">
      <div class="aurora aurora--p1"></div>
      <div class="aurora aurora--p2"></div>
    </div>

    <div class="container">
      <div class="piliers-intro">
        <span class="kicker kicker--center reveal-fade">— Trois piliers de confiance</span>
        <h2 class="acte__titre titre-words" data-words="Notre rapport au travail"></h2>
        <h2 class="acte__titre acte__titre--shimmer titre-words" data-words="se mesure en chiffres."></h2>
      </div>

      <div class="piliers-fil" aria-hidden="true">
        <span class="piliers-fil__line"></span>
        <span class="piliers-fil__dot piliers-fil__dot--1"></span>
        <span class="piliers-fil__dot piliers-fil__dot--2"></span>
        <span class="piliers-fil__dot piliers-fil__dot--3"></span>
      </div>

      <div class="piliers-grille">

        {/* Pilier 1 — Liberté */}
        <article class="pilier reveal-pilier" style="--delay: 0ms;">
          <div class="pilier__num-wrap">
            <span class="pilier__num">I</span>
          </div>
          <h3 class="pilier__nom">Liberté</h3>
          <p class="pilier__texte">Vous n'êtes lié à personne. Aucun contrat de longue durée imposé.</p>

          <div class="pilier__kpi">
            <div class="pilier__kpi-val-wrap">
              <span class="pilier__kpi-val">0</span>
              <span class="pilier__kpi-decor" aria-hidden="true"></span>
            </div>
            <span class="pilier__kpi-label">Engagement<br/>longue durée imposé</span>
          </div>
        </article>

        {/* Pilier 2 — Transparence */}
        <article class="pilier reveal-pilier" style="--delay: 120ms;">
          <div class="pilier__num-wrap">
            <span class="pilier__num">II</span>
          </div>
          <h3 class="pilier__nom">Transparence</h3>
          <p class="pilier__texte">Réponse rapide, point d'avancement régulier, aucune zone d'ombre.</p>

          <div class="pilier__kpi">
            <div class="pilier__kpi-val-wrap">
              <span class="pilier__kpi-val pilier__kpi-val--small">&lt; 48<span class="pilier__kpi-unit">h</span></span>
              <span class="pilier__kpi-decor" aria-hidden="true"></span>
            </div>
            <span class="pilier__kpi-label">Délai<br/>de réponse garanti</span>
          </div>
        </article>

        {/* Pilier 3 — Résultat */}
        <article class="pilier reveal-pilier" style="--delay: 240ms;">
          <div class="pilier__num-wrap">
            <span class="pilier__num">III</span>
          </div>
          <h3 class="pilier__nom">Résultat</h3>
          <p class="pilier__texte">Livré dans les délais, mesuré, validé par le client. Toujours.</p>

          <div class="pilier__kpi">
            <div class="pilier__kpi-val-wrap">
              <span class="pilier__kpi-val">100<span class="pilier__kpi-unit">%</span></span>
              <span class="pilier__kpi-decor" aria-hidden="true"></span>
            </div>
            <span class="pilier__kpi-label">Projets livrés<br/>dans les délais</span>
          </div>
        </article>

      </div>

      {/* Satisfaction client — bandeau hero plein largeur */}
      <div class="satisfaction reveal-fade">
        <div class="satisfaction__halo" aria-hidden="true"></div>

        <div class="satisfaction__contenu">
          <span class="satisfaction__eyebrow">— Et nos clients ?</span>

          <div class="satisfaction__main">
            <div class="satisfaction__note">
              <span class="satisfaction__note-val">4.9</span>
              <span class="satisfaction__note-sep">/</span>
              <span class="satisfaction__note-max">5</span>
            </div>

            <div class="satisfaction__stars" aria-hidden="true">
              <div class="satisfaction__stars-rail">
                <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
              </div>
              <div class="satisfaction__stars-fill">
                <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
              </div>
            </div>
          </div>

          <p class="satisfaction__label">Satisfaction client moyenne — basée sur les retours de nos clients</p>

          {/* Avis clients intégrés dans le bandeau */}
          <div class="avis-grille">
            <article class="avis-carte reveal-pilier" style="--delay: 0ms;">
              <div class="avis-carte__top">
                <div class="avis-carte__avatar" aria-hidden="true">
                  <span>S</span>
                </div>
                <div class="avis-carte__stars" aria-hidden="true">
                  <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                </div>
              </div>
              <p class="avis-carte__texte">
                Travail d'orfèvre. Le dashboard livré nous a fait gagner deux jours
                par semaine sur le reporting commercial. Très réactif.
              </p>
              <div class="avis-carte__meta">
                <span class="avis-carte__nom">Sophie L.</span>
                <span class="avis-carte__role">Directrice commerciale</span>
              </div>
            </article>

            <article class="avis-carte reveal-pilier" style="--delay: 120ms;">
              <div class="avis-carte__top">
                <div class="avis-carte__avatar avis-carte__avatar--2" aria-hidden="true">
                  <span>M</span>
                </div>
                <div class="avis-carte__stars" aria-hidden="true">
                  <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                </div>
              </div>
              <p class="avis-carte__texte">
                Site livré en avance, code clair, SEO impeccable. Un partenaire
                qui tient ses délais et explique tout — rare.
              </p>
              <div class="avis-carte__meta">
                <span class="avis-carte__nom">Marc D.</span>
                <span class="avis-carte__role">Co-fondateur, startup SaaS</span>
              </div>
            </article>

            <article class="avis-carte reveal-pilier" style="--delay: 240ms;">
              <div class="avis-carte__top">
                <div class="avis-carte__avatar avis-carte__avatar--3" aria-hidden="true">
                  <span>C</span>
                </div>
                <div class="avis-carte__stars" aria-hidden="true">
                  <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                </div>
              </div>
              <p class="avis-carte__texte">
                L'agent IA déployé répond à 80% des demandes support. ROI
                atteint en moins de trois mois. Pédagogie au top.
              </p>
              <div class="avis-carte__meta">
                <span class="avis-carte__nom">Camille R.</span>
                <span class="avis-carte__role">Responsable opérations</span>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
       CHAPITRE IV — LE PARCOURS
       ═══════════════════════════════════════════ */}
  <section class="chapitre chapitre--parcours">
    <div class="parcours-bg" aria-hidden="true">
      <div class="aurora aurora--pa1"></div>
      <div class="aurora aurora--pa2"></div>
      <div class="grid-soft grid-soft--dark"></div>
    </div>

    <div class="container">
      <div class="parcours-intro">
        <span class="kicker kicker--center kicker--clair reveal-fade">— Notre parcours</span>
        <h2 class="acte__titre acte__titre--clair titre-words" data-words="Une trajectoire bâtie"></h2>
        <h2 class="acte__titre acte__titre--shimmer titre-words" data-words="par la rigueur."></h2>
      </div>

      <ol class="parcours-timeline">
        <li class="parcours-step reveal-pilier" style="--delay: 0ms;">
          <div class="parcours-step__bullet" aria-hidden="true">
            <span class="parcours-step__ring"></span>
            <span class="parcours-step__core"></span>
          </div>
          <div class="parcours-step__contenu">
            <span class="parcours-step__year">2019</span>
            <h3 class="parcours-step__titre">Premières missions</h3>
            <p class="parcours-step__texte">Conseil en transformation digitale, automatisation de processus métier.</p>
          </div>
        </li>

        <li class="parcours-step reveal-pilier" style="--delay: 120ms;">
          <div class="parcours-step__bullet" aria-hidden="true">
            <span class="parcours-step__ring"></span>
            <span class="parcours-step__core"></span>
          </div>
          <div class="parcours-step__contenu">
            <span class="parcours-step__year">2021</span>
            <h3 class="parcours-step__titre">Spécialisation data</h3>
            <p class="parcours-step__texte">Reporting, dashboards, analyses business pour PME et ETI.</p>
          </div>
        </li>

        <li class="parcours-step reveal-pilier" style="--delay: 240ms;">
          <div class="parcours-step__bullet" aria-hidden="true">
            <span class="parcours-step__ring"></span>
            <span class="parcours-step__core"></span>
          </div>
          <div class="parcours-step__contenu">
            <span class="parcours-step__year">2023</span>
            <h3 class="parcours-step__titre">Sites web premium</h3>
            <p class="parcours-step__texte">Création de sites vitrines et plateformes sur-mesure, focus SEO.</p>
          </div>
        </li>

        <li class="parcours-step reveal-pilier" style="--delay: 360ms;">
          <div class="parcours-step__bullet" aria-hidden="true">
            <span class="parcours-step__ring"></span>
            <span class="parcours-step__core"></span>
          </div>
          <div class="parcours-step__contenu">
            <span class="parcours-step__year">2024</span>
            <h3 class="parcours-step__titre">Agents IA & automatisation</h3>
            <p class="parcours-step__texte">Intégration de Claude, GPT, n8n. Automatisations de bout en bout.</p>
          </div>
        </li>

        <li class="parcours-step reveal-pilier" style="--delay: 480ms;">
          <div class="parcours-step__bullet" aria-hidden="true">
            <span class="parcours-step__ring"></span>
            <span class="parcours-step__core"></span>
          </div>
          <div class="parcours-step__contenu">
            <span class="parcours-step__year">2026</span>
            <h3 class="parcours-step__titre">Aujourd'hui</h3>
            <p class="parcours-step__texte">Cabinet en pleine croissance. De nouveaux clients chaque trimestre.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
       CTA FINAL
       ═══════════════════════════════════════════ */}
  <section class="cta-final">
    <div class="cta-final__halo" aria-hidden="true"></div>

    <div class="container cta-final__inner">
      <h2 class="cta-final__titre">
        <span class="titre-words" data-words="Construisons ensemble"></span><br/>
        <span class="cta-final__shimmer titre-words" data-words="ce qui crée de la valeur."></span>
      </h2>
      <div class="cta-final__actions reveal-fade">
        <a href="/devis" class="btn btn--primaire">Démarrer un projet</a>
        <a href="/contact" class="btn btn--outline">Nous contacter</a>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  /* ═══════════════════════════════════════════
     PALETTE & TYPO — TOUT EN BLEU
     ═══════════════════════════════════════════ */
  :root {
    --txt-principal:  #1a2e50;   /* bleu-moyen, remplace le noir */
    --txt-secondaire: #4a70c0;
    --txt-tertiaire:  #6b91d4;
    --txt-doux:       #8da6d4;
  }

  .chapitre {
    position: relative;
    overflow: hidden;
    padding: 9rem 0;
  }

  .container { position: relative; z-index: 2; }

  /* ═══════════════════════════════════════════
     KICKERS & TITRES (TOUT BLEU)
     ═══════════════════════════════════════════ */
  .kicker {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--bleu-vif);
    margin-bottom: 1.6rem;
  }
  .kicker--center { display: block; text-align: center; }

  .acte__titre {
    font-family: inherit;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--bleu-marine);
    text-align: center;
    margin: 0 auto;
    max-width: 920px;
  }
  .acte__titre--shimmer,
  .manifeste-titre__line--shimmer,
  .cta-final__shimmer {
    background: linear-gradient(
      100deg,
      #4a70c0 0%,
      #6B91D4 20%,
      #A0B4DE 35%,
      #c8d8f0 50%,
      #A0B4DE 65%,
      #6B91D4 80%,
      #4a70c0 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: shimmer-flow 6s ease-in-out infinite;
  }
  @keyframes shimmer-flow {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  /* ═══════════════════════════════════════════
     WORD-REVEAL (toujours bleu)
     ═══════════════════════════════════════════ */
  .word {
    display: inline-block;
    opacity: 0;
    transform: translateY(22px);
    filter: blur(8px);
    transition:
      opacity 0.65s cubic-bezier(0.23, 1, 0.32, 1),
      transform 0.65s cubic-bezier(0.23, 1, 0.32, 1),
      filter 0.65s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .word.is-revealed {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .reveal-fade {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.85s ease, transform 0.85s ease;
  }
  .reveal-fade.is-revealed { opacity: 1; transform: translateY(0); }

  .reveal-paragraph {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.75s ease, transform 0.75s ease;
  }
  .reveal-paragraph.is-revealed { opacity: 1; transform: translateY(0); }

  .reveal-pilier {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.85s cubic-bezier(0.23, 1, 0.32, 1),
      transform 0.85s cubic-bezier(0.23, 1, 0.32, 1);
    transition-delay: var(--delay, 0ms);
  }
  .reveal-pilier.is-revealed { opacity: 1; transform: translateY(0); }

  /* ═══════════════════════════════════════════
     CHAPITRE I — OUVERTURE (light & lumineux)
     ═══════════════════════════════════════════ */
  .chapitre--ouverture {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 0 6rem;
    background:
      radial-gradient(ellipse at 20% 0%, rgba(160, 180, 222, 0.18) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 100%, rgba(107, 145, 212, 0.12) 0%, transparent 50%),
      linear-gradient(180deg, #f7faff 0%, #eef3fb 100%);
  }

  .grid-soft {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(160, 180, 222, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(160, 180, 222, 0.07) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: radial-gradient(ellipse at center, black 35%, transparent 75%);
    pointer-events: none;
  }

  .aurora {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
    animation: aurora-drift 18s ease-in-out infinite;
  }
  .aurora--1 {
    width: 520px; height: 520px;
    top: -120px; left: -100px;
    background: radial-gradient(circle, rgba(107, 145, 212, 0.45), transparent 65%);
  }
  .aurora--2 {
    width: 600px; height: 600px;
    bottom: -180px; right: -100px;
    background: radial-gradient(circle, rgba(160, 180, 222, 0.4), transparent 65%);
    animation-delay: -6s;
  }
  .aurora--3 {
    width: 380px; height: 380px;
    top: 40%; left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(200, 216, 240, 0.35), transparent 70%);
    animation-delay: -12s;
  }
  @keyframes aurora-drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(40px, -30px) scale(1.05); }
    66%      { transform: translate(-30px, 40px) scale(0.96); }
  }

  .chapitre__container {
    text-align: center;
    max-width: 980px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .manifeste-titre {
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 2.4rem;
  }
  .manifeste-titre__line {
    display: block;
    color: var(--bleu-marine);
  }
  .manifeste-titre__line + .manifeste-titre__line { margin-top: 0.3rem; }

  .manifeste-trace {
    width: 100%;
    max-width: 280px;
    margin: 0 auto 2rem;
    height: 8px;
  }
  .manifeste-trace svg { width: 100%; height: 100%; overflow: visible; }
  .manifeste-trace__line {
    stroke: url(#trace-grad);
    stroke-width: 2;
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
  }
  .manifeste-trace.is-revealed .manifeste-trace__line {
    animation: trace-draw 1.6s 0.4s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    stroke: #6B91D4;
  }
  @keyframes trace-draw {
    to { stroke-dashoffset: 0; }
  }

  .manifeste-intro {
    display: block;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 500;
    color: var(--txt-secondaire);
    line-height: 1.5;
    max-width: 720px;
    margin: 0 auto;
    letter-spacing: -0.01em;
  }

  .chapitre__scroll {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    z-index: 5;
  }
  .chapitre__scroll-label {
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--bleu-vif);
    font-weight: 600;
  }
  .chapitre__scroll-line {
    width: 1.5px;
    height: 50px;
    background: linear-gradient(to bottom, var(--bleu-vif), transparent);
    animation: scroll-pulse-bleu 2s ease-in-out infinite;
  }
  @keyframes scroll-pulse-bleu {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; opacity: 1; }
    51%  { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0.4; }
  }

  /* ═══════════════════════════════════════════
     CHAPITRE II — MANIFESTE & ENGAGEMENTS
     ═══════════════════════════════════════════ */
  .chapitre--manifeste {
    background: linear-gradient(180deg, #eef3fb 0%, #f7faff 50%, #ffffff 100%);
    padding: 8rem 0;
  }

  .manifeste-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
  }
  .manifeste-blob--1 {
    width: 460px; height: 460px;
    top: 10%; left: -120px;
    background: rgba(107, 145, 212, 0.15);
  }
  .manifeste-blob--2 {
    width: 540px; height: 540px;
    bottom: 5%; right: -160px;
    background: rgba(160, 180, 222, 0.18);
  }

  .word-line {
    display: inline;
  }

  .engagements-intro {
    text-align: center;
    margin-bottom: 4rem;
  }

  .engagements-grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .engagement-carte {
    position: relative;
    padding: 2.4rem 1.8rem 2rem;
    border-radius: var(--rayon-lg);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(160, 180, 222, 0.25);
    backdrop-filter: blur(10px);
    overflow: hidden;
    cursor: pointer;
    transition:
      transform 0.45s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.45s ease,
      border-color 0.45s ease,
      background 0.5s ease;
  }
  .engagement-carte::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(135deg, transparent 30%, rgba(107, 145, 212, 0.5), transparent 70%);
    opacity: 0;
    transition: opacity 0.45s ease;
    z-index: -1;
    border-radius: inherit;
  }
  .engagement-carte:hover {
    transform: translateY(-8px);
    background: linear-gradient(155deg, #0d1830 0%, #1a2e50 100%);
    border-color: rgba(160, 180, 222, 0.45);
    box-shadow:
      0 24px 60px rgba(13, 24, 48, 0.32),
      0 0 0 1px rgba(160, 180, 222, 0.18);
  }
  .engagement-carte:hover::before { opacity: 1; }

  .engagement-carte__num {
    position: absolute;
    top: 1.2rem;
    right: 1.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: rgba(107, 145, 212, 0.55);
    transition: color 0.45s ease;
  }
  .engagement-carte:hover .engagement-carte__num {
    color: rgba(160, 180, 222, 0.7);
  }

  .engagement-carte__icone-wrap {
    position: relative;
    width: 80px;
    height: 80px;
    margin-bottom: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .engagement-carte__icone-halo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(107, 145, 212, 0.22), rgba(160, 180, 222, 0.05) 70%);
    opacity: 0.7;
    transition: all 0.5s ease;
    transform: scale(1);
  }
  .engagement-carte__icone-img {
    position: relative;
    width: 56px;
    height: 56px;
    object-fit: contain;
    z-index: 2;
    transition: transform 0.55s cubic-bezier(0.23, 1, 0.32, 1), filter 0.45s ease;
    filter: drop-shadow(0 4px 12px rgba(107, 145, 212, 0.25));
  }
  .engagement-carte:hover .engagement-carte__icone-halo {
    transform: scale(1.18);
    background: radial-gradient(circle, rgba(160, 180, 222, 0.4), rgba(160, 180, 222, 0.08) 70%);
    opacity: 1;
    animation: halo-pulse 2.4s ease-in-out infinite;
  }
  .engagement-carte:hover .engagement-carte__icone-img {
    transform: scale(1.12) rotate(-3deg);
    filter: drop-shadow(0 6px 18px rgba(160, 180, 222, 0.5));
  }
  @keyframes halo-pulse {
    0%, 100% { transform: scale(1.18); opacity: 1; }
    50%      { transform: scale(1.3); opacity: 0.7; }
  }

  .engagement-carte__titre {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.8rem;
    background: linear-gradient(
      100deg,
      #0d1830 0%, #1a2e50 30%, #4a70c0 45%,
      #6B91D4 50%, #4a70c0 55%, #1a2e50 70%, #0d1830 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: shimmer-flow 4s linear infinite;
    transition: filter 0.4s ease;
  }
  .engagement-carte:hover .engagement-carte__titre {
    background: linear-gradient(
      100deg,
      #c8d8f0 0%, #ffffff 30%, #A0B4DE 45%,
      #6B91D4 50%, #A0B4DE 55%, #ffffff 70%, #c8d8f0 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .engagement-carte__texte {
    font-size: 0.97rem;
    line-height: 1.65;
    color: var(--txt-secondaire);
    transition: color 0.45s ease;
  }
  .engagement-carte:hover .engagement-carte__texte {
    color: rgba(200, 216, 240, 0.85);
  }

  /* ═══════════════════════════════════════════
     CHAPITRE III — TROIS PILIERS + INDICATEURS
     ═══════════════════════════════════════════ */
  .chapitre--piliers {
    padding: 9rem 0;
    background:
      linear-gradient(180deg, #ffffff 0%, #f0f4fa 70%, #eef3fb 100%);
  }
  .piliers-bg { position: absolute; inset: 0; pointer-events: none; }
  .aurora--p1 {
    width: 600px; height: 600px;
    top: 10%; left: -180px;
    background: radial-gradient(circle, rgba(107, 145, 212, 0.18), transparent 70%);
  }
  .aurora--p2 {
    width: 700px; height: 700px;
    bottom: -10%; right: -200px;
    background: radial-gradient(circle, rgba(160, 180, 222, 0.22), transparent 70%);
    animation-delay: -8s;
  }

  .piliers-intro {
    text-align: center;
    margin-bottom: 5rem;
  }

  .piliers-fil {
    position: relative;
    width: 100%;
    max-width: 900px;
    height: 3rem;
    margin: 0 auto 2rem;
  }
  .piliers-fil__line {
    position: absolute;
    top: 50%;
    left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--bleu-vif), var(--bleu), var(--bleu-vif), transparent);
    transform: scaleX(0);
    transform-origin: left;
    animation: line-grow 2.4s 0.3s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }
  @keyframes line-grow { to { transform: scaleX(1); } }
  .piliers-fil__dot {
    position: absolute;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bleu-vif);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 6px rgba(107, 145, 212, 0.18), 0 0 20px rgba(107, 145, 212, 0.4);
    animation: dot-pop 0.6s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    opacity: 0;
  }
  .piliers-fil__dot--1 { left: 16.66%; animation-delay: 0.6s; }
  .piliers-fil__dot--2 { left: 50%;    animation-delay: 1.2s; }
  .piliers-fil__dot--3 { left: 83.33%; animation-delay: 1.8s; }
  @keyframes dot-pop {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  .piliers-grille {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1180px;
    margin: 0 auto;
  }

  .pilier {
    position: relative;
    text-align: center;
    padding: 4rem 1.8rem 2.4rem;
    border-radius: var(--rayon-xl);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(160, 180, 222, 0.25);
    backdrop-filter: blur(10px);
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.5s ease, border-color 0.5s ease;
    overflow: hidden;
  }
  .pilier::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, transparent, var(--bleu-vif), var(--bleu), var(--bleu-vif), transparent);
    transform: scaleX(0);
    transition: transform 0.6s ease;
  }
  .pilier:hover {
    transform: translateY(-10px);
    box-shadow: 0 28px 70px rgba(107, 145, 212, 0.22);
    border-color: rgba(107, 145, 212, 0.45);
  }
  .pilier:hover::before { transform: scaleX(1); }

  .pilier__num-wrap {
    position: absolute;
    top: 1.4rem;
    right: 1.6rem;
  }
  .pilier__num {
    font-family: 'SF Pro Display', -apple-system, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    font-weight: 700;
    color: rgba(107, 145, 212, 0.45);
    padding: 0.35rem 0.8rem;
    border: 1px solid rgba(107, 145, 212, 0.25);
    border-radius: 2rem;
    text-transform: uppercase;
  }

  @keyframes halo-breathe {
    0%, 100% { transform: scale(1); opacity: 0.7; }
    50%      { transform: scale(1.08); opacity: 1; }
  }

  .pilier__nom {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
    margin-top: 1rem;
    background: linear-gradient(135deg, #1a2e50 0%, #4a70c0 50%, #6B91D4 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: shimmer-flow 5s ease-in-out infinite;
  }

  .pilier__texte {
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--txt-secondaire);
    max-width: 280px;
    margin: 0 auto 2rem;
  }

  /* KPI bloc — design soigné */
  .pilier__kpi {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding-top: 1.6rem;
    margin-top: auto;
    border-top: 1px solid rgba(160, 180, 222, 0.25);
    position: relative;
  }
  .pilier__kpi::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--bleu-vif), transparent);
  }

  .pilier__kpi-val-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pilier__kpi-val {
    font-size: 3.4rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    background: linear-gradient(135deg, #4a70c0 0%, #6B91D4 50%, #A0B4DE 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: shimmer-flow 4s ease-in-out infinite;
  }
  .pilier__kpi-val--small { font-size: 2.6rem; }
  .pilier__kpi-unit {
    font-size: 0.55em;
    font-weight: 700;
    margin-left: 0.05em;
    vertical-align: 0.4em;
    opacity: 0.85;
  }
  .pilier__kpi-decor {
    position: absolute;
    inset: -8px -16px;
    border: 1.5px solid rgba(107, 145, 212, 0.18);
    border-radius: 1rem;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.4s ease;
    transform: scale(0.95);
  }
  .pilier:hover .pilier__kpi-decor {
    opacity: 1;
    transform: scale(1);
  }
  .pilier__kpi-label {
    font-size: 0.78rem;
    color: var(--txt-tertiaire);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
  }

  /* ═══════════════════════════════════════════
     SATISFACTION CLIENT — bandeau hero
     ═══════════════════════════════════════════ */
  .satisfaction {
    position: relative;
    margin-top: 6rem;
    padding: 4rem 2.5rem;
    border-radius: var(--rayon-xl);
    background:
      linear-gradient(135deg, rgba(13, 24, 48, 0.98) 0%, rgba(26, 46, 80, 0.98) 100%);
    overflow: hidden;
    border: 1px solid rgba(160, 180, 222, 0.18);
    box-shadow:
      0 30px 80px rgba(13, 24, 48, 0.3),
      inset 0 1px 0 rgba(160, 180, 222, 0.08);
  }
  .satisfaction__halo {
    position: absolute;
    width: 700px;
    height: 700px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(160, 180, 222, 0.18), transparent 65%);
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    animation: halo-breathe 6s ease-in-out infinite;
  }
  .satisfaction__contenu {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  .satisfaction__eyebrow {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(160, 180, 222, 0.7);
    margin-bottom: 1.6rem;
  }

  .satisfaction__main {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    margin-bottom: 1.4rem;
    flex-wrap: wrap;
  }

  .satisfaction__note {
    display: flex;
    align-items: baseline;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .satisfaction__note-val {
    font-size: clamp(4rem, 8vw, 6.5rem);
    font-weight: 800;
    background: linear-gradient(135deg, #ffffff 0%, #c8d8f0 50%, #A0B4DE 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: shimmer-flow 4s ease-in-out infinite;
  }
  .satisfaction__note-sep {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 300;
    color: rgba(160, 180, 222, 0.5);
    margin: 0 0.4rem;
  }
  .satisfaction__note-max {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 600;
    color: rgba(200, 216, 240, 0.55);
  }

  .satisfaction__stars {
    position: relative;
    display: inline-block;
  }
  .satisfaction__stars-rail,
  .satisfaction__stars-fill {
    display: flex;
    gap: 0.4rem;
    font-size: clamp(2rem, 4vw, 2.6rem);
    line-height: 1;
  }
  .satisfaction__stars-rail {
    color: rgba(160, 180, 222, 0.22);
  }
  .satisfaction__stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    color: #A0B4DE;
    text-shadow: 0 0 16px rgba(160, 180, 222, 0.6);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 2s 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .satisfaction.is-revealed .satisfaction__stars-fill {
    clip-path: inset(0 2% 0 0);
  }
  .satisfaction__stars-fill .star {
    background: linear-gradient(135deg, #c8d8f0, #A0B4DE 50%, #6B91D4);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .satisfaction__label {
    font-size: 0.92rem;
    color: rgba(200, 216, 240, 0.65);
    font-weight: 500;
    letter-spacing: 0.04em;
    max-width: 480px;
    margin: 0 auto;
  }

  /* ═══════════════════════════════════════════
     AVIS CLIENTS — intégrés dans bandeau sombre
     ═══════════════════════════════════════════ */
  .avis-grille {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
    margin-top: 3.5rem;
    text-align: left;
  }

  .avis-carte {
    position: relative;
    padding: 1.8rem 1.6rem 1.6rem;
    border-radius: var(--rayon-lg);
    background: rgba(160, 180, 222, 0.06);
    border: 1px solid rgba(160, 180, 222, 0.18);
    backdrop-filter: blur(8px);
    transition:
      transform 0.5s cubic-bezier(0.23, 1, 0.32, 1),
      background 0.5s ease,
      border-color 0.5s ease,
      box-shadow 0.5s ease;
    overflow: hidden;
  }
  .avis-carte::before {
    content: '"';
    position: absolute;
    top: -1.4rem;
    right: 1rem;
    font-family: Georgia, serif;
    font-size: 6rem;
    line-height: 1;
    color: rgba(160, 180, 222, 0.12);
    font-weight: 700;
    pointer-events: none;
    transition: color 0.5s ease, transform 0.5s ease;
  }
  .avis-carte::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(160, 180, 222, 0.08), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .avis-carte:hover {
    transform: translateY(-6px);
    background: rgba(160, 180, 222, 0.1);
    border-color: rgba(160, 180, 222, 0.4);
    box-shadow: 0 18px 50px rgba(13, 24, 48, 0.45);
  }
  .avis-carte:hover::before {
    color: rgba(160, 180, 222, 0.3);
    transform: translateY(-4px);
  }
  .avis-carte:hover::after { opacity: 1; }

  .avis-carte__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
    position: relative;
    z-index: 2;
  }

  .avis-carte__avatar {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6B91D4, #4a70c0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    box-shadow:
      0 4px 16px rgba(107, 145, 212, 0.45),
      0 0 0 3px rgba(160, 180, 222, 0.18);
    flex-shrink: 0;
  }
  .avis-carte__avatar::before {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px dashed rgba(160, 180, 222, 0.3);
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.6s ease;
    transform: scale(0.9);
  }
  .avis-carte:hover .avis-carte__avatar::before {
    opacity: 1;
    transform: scale(1);
    animation: rotate-slow 12s linear infinite;
  }
  @keyframes rotate-slow { to { transform: scale(1) rotate(360deg); } }
  .avis-carte__avatar--2 {
    background: linear-gradient(135deg, #A0B4DE, #6B91D4);
  }
  .avis-carte__avatar--3 {
    background: linear-gradient(135deg, #c8d8f0, #4a70c0);
  }

  .avis-carte__stars {
    display: flex;
    gap: 0.18rem;
    font-size: 0.95rem;
    color: #c8d8f0;
    text-shadow: 0 0 10px rgba(160, 180, 222, 0.5);
  }

  .avis-carte__texte {
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(220, 230, 245, 0.85);
    margin-bottom: 1.4rem;
    font-style: italic;
    position: relative;
    z-index: 2;
  }

  .avis-carte__meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(160, 180, 222, 0.18);
    position: relative;
    z-index: 2;
  }
  .avis-carte__nom {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--blanc);
    letter-spacing: -0.01em;
  }
  .avis-carte__role {
    font-size: 0.78rem;
    color: rgba(160, 180, 222, 0.7);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  @media (max-width: 900px) {
    .avis-grille { grid-template-columns: 1fr; gap: 1.2rem; }
  }

  /* ═══════════════════════════════════════════
     CHAPITRE IV — PARCOURS
     ═══════════════════════════════════════════ */
  .chapitre--parcours {
    background: linear-gradient(180deg, #070d1a 0%, #0d1830 50%, #1a2e50 100%);
    padding: 9rem 0;
    color: var(--blanc);
  }
  .parcours-bg { position: absolute; inset: 0; pointer-events: none; }
  .grid-soft--dark {
    background-image:
      linear-gradient(rgba(160, 180, 222, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(160, 180, 222, 0.05) 1px, transparent 1px);
  }
  .aurora--pa1 {
    width: 600px; height: 600px;
    top: -120px; right: -180px;
    background: radial-gradient(circle, rgba(107, 145, 212, 0.32), transparent 70%);
  }
  .aurora--pa2 {
