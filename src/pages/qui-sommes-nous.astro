    background: linear-gradient(180deg, transparent, rgba(160, 180, 222, 0.4) 10%, var(--bleu) 50%, rgba(160, 180, 222, 0.4) 90%, transparent);
  }

  .parcours-step {
    position: relative;
    padding: 0 0 3rem 2rem;
  }
  .parcours-step:last-child { padding-bottom: 0; }

  .parcours-step__bullet {
    position: absolute;
    left: -3rem;
    top: 0.3rem;
    width: 26px;
