---
import MainLayout from '../layouts/MainLayout.astro';
import { translations } from '../i18n/translations';
const t = translations.fr;

const outils = [
  { src: '/assets/outils/claude.png',      alt: 'Claude' },
  { src: '/assets/outils/gpt.png',         alt: 'GPT' },
  { src: '/assets/outils/python.png',      alt: 'Python' },
  { src: '/assets/outils/powerbi.png',     alt: 'Power BI' },
  { src: '/assets/outils/postgresql.png',  alt: 'PostgreSQL' },
  { src: '/assets/outils/github.png',      alt: 'GitHub' },
  { src: '/assets/outils/docker.png',      alt: 'Docker' },
  { src: '/assets/outils/vs-code.png',     alt: 'VS Code' },
  { src: '/assets/outils/n8n.svg',         alt: 'n8n' },
  { src: '/assets/outils/hostinger.svg',   alt: 'Hostinger' },
];
---

<MainLayout title="Nal Consulting — Transformation digitale">

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero__blob hero__blob--1" aria-hidden="true"></div>
    <div class="hero__blob hero__blob--2" aria-hidden="true"></div>
    <div class="hero__blob hero__blob--3" aria-hidden="true"></div>
    <div class="hero__dots" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__badge animate-in" style="animation-delay:.1s">
        <span class="badge badge--sombre" data-i18n="hero.badge">{t.hero.badge}</span>
      </div>
      <h1 class="hero__titre animate-in" style="animation-delay:.2s">
        <span data-i18n="hero.title.0">{t.hero.title[0]}</span><br />
        <span class="hero__gradient" data-i18n="hero.title.1">{t.hero.title[1]}</span>
      </h1>
<div class="hero__ctas animate-in" style="animation-delay:.38s">
        <a href="/devis" class="btn btn--primaire">
          <span data-i18n="hero.ctaPrimary">{t.hero.ctaPrimary}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>

    <!-- ═══ MARQUEE sur fond bleu ═══ -->
    <div class="marquee-section">
      <!-- Label word-reveal, au-dessus du séparateur -->
      <div class="marquee-label" aria-label="EN UTILISANT LES MEILLEURS OUTILS DU MARCHÉ">
        {t.marquee.words.map((word, wi) => (
          <span class="marquee-word" style={`animation-delay:${0.15 + wi * 0.1}s`} data-i18n={`marquee.words.${wi}`}>{word}</span>
        ))}
      </div>
      <!-- Séparateur -->
      <div class="marquee-sep" aria-hidden="true"></div>
      <div class="marquee-track-wrap" aria-hidden="true">
        <div class="marquee-track">
          {[...outils, ...outils].map((o) => (
            <div class={`marquee-item ${o.alt === 'n8n' ? 'marquee-item--large' : ''}`}>
              <img src={o.src} alt={o.alt} width="48" height="48" loading="lazy" />
              <span>{o.alt}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section class="section services-section" id="services">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow" data-i18n="services.eyebrow">{t.services.eyebrow}</span>
        <h2 class="titre-section">
          <span data-i18n="services.title.0">{t.services.title[0]}</span><br />
          <span data-i18n="services.title.1">{t.services.title[1]}</span>
        </h2>
        <p class="sous-titre" data-i18n="services.subtitle">{t.services.subtitle}</p>
      </div>

      <div class="services-grid">
        {[
          { ...t.services.items[0], href: '/nos-expertises', idx: 0 },
          { ...t.services.items[1], href: '/nos-expertises', idx: 1 },
          { ...t.services.items[2], href: '/nos-expertises', idx: 2 },
        ].map((s, i) => (
          <article class="svc-carte reveal" style={`transition-delay:${i * 0.14}s`}>
            <div class="svc-carte__top">
              <!-- Visualisation custom par expertise -->
              <div class="svc-carte__visual">
                {i === 0 && (
                  <canvas id="miniGlobe" class="mini-canvas" width="110" height="110" aria-hidden="true"></canvas>
                )}
                {i === 1 && (
                  <div class="mini-bars-wrap" aria-hidden="true">
                    {[55,78,47,92,68,85].map((h, bi) => (
                      <div class="mini-bar" style={`--h:${h}%;--delay:${bi*0.12}s`}></div>
                    ))}
                  </div>
                )}
                {i === 2 && (
                  <canvas id="miniBrain" class="mini-canvas" width="110" height="110" aria-hidden="true"></canvas>
                )}
              </div>
              <span class="svc-carte__num" data-i18n={`services.items.${i}.num`}>{s.num}</span>
            </div>
            <div class="svc-carte__encart">
              <h3 class="svc-carte__titre" data-i18n={`services.items.${i}.title`}>{s.title}</h3>
              <p class="svc-carte__desc"   data-i18n={`services.items.${i}.desc`}>{s.desc}</p>
            </div>
            <div class="svc-tags">
              {s.points.map((p, pi) => (
                <span class="svc-tag" data-i18n={`services.items.${i}.points.${pi}`}>{p}</span>
              ))}
            </div>
            <a href={s.href} class="svc-carte__link svc-carte__link--shimmer">
              <span data-i18n="services.learnMore">{t.services.learnMore}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <div class="svc-carte__bar" aria-hidden="true"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TIMELINE VERTICALE ═══ -->
  <section class="section section--gris process-section" id="process">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow" data-i18n="process.eyebrow">{t.process.eyebrow}</span>
        <h2 class="titre-section process-title-reveal" aria-label="Simple. Transparent. Efficace.">
          {t.process.titleWords.map((w, wi) => (
            <span class="proc-word" data-delay={wi * 0.18} data-i18n={`process.titleWords.${wi}`}>{w}</span>
          ))}
        </h2>
      </div>

      <div class="timeline" id="timeline">
        <div class="timeline__line" id="timelineLine" aria-hidden="true">
          <div class="timeline__line-fill" id="timelineFill"></div>
        </div>

        {t.process.steps.map((step, i) => {
          const nodeKw = ['Brief', 'Devis', 'Build', 'Live'];
          const stepIcons = [
            '/assets/notre-approche/decouverte.svg',
            '/assets/notre-approche/proposition.svg',
            '/assets/notre-approche/realisation.png',
            '/assets/notre-approche/livraison.png',
          ];
          return (
            <div class={`timeline__step timeline__step--${i % 2 === 0 ? 'left' : 'right'}`}
                 data-step={i} id={`step-${i}`}>
              <!-- Nœud central : ring progress animé + numéro -->
              <div class="timeline__node" aria-hidden="true">
                <svg class="timeline__ring" viewBox="0 0 80 80">
                  <circle class="timeline__ring-bg"   cx="40" cy="40" r="34"/>
                  <circle class="timeline__ring-fill" cx="40" cy="40" r="34"/>
                </svg>
                <span class="timeline__node-num">{String(i + 1).padStart(2, '0')}</span>
              </div>

              <!-- Carte premium avec faisceau lumineux + flottement -->
              <div class="timeline__card">
                <div class="timeline__card-inner">
                  <!-- Faisceau animé autour de la carte -->
                  <div class="timeline__card-beam" aria-hidden="true"></div>

                  <div class="timeline__card-head">
                    <span class="timeline__card-icon">
                      <img src={stepIcons[i]} alt="" width="24" height="24" loading="lazy" />
                    </span>
                    <span class="timeline__card-kw">{nodeKw[i]}</span>
                  </div>
                  <p class="timeline__step-label" data-i18n={`process.steps.${i}.title`}>{step.title}</p>
                  <p class="timeline__step-desc"  data-i18n={`process.steps.${i}.desc`}>{step.desc}</p>
                  <div class="timeline__card-glow" aria-hidden="true"></div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══ POURQUOI NAL — KPIs ═══ -->
  <section class="section why-section">
    <div class="container">
      <div class="why-header section-head reveal">
        <span class="eyebrow" data-i18n="why.eyebrow">{t.why.eyebrow}</span>
        <h2 class="titre-section">
          <span data-i18n="why.title.0">{t.why.title[0]}</span><br />
          <span data-i18n="why.title.1">{t.why.title[1]}</span>
        </h2>
      </div>

      <div class="kpi-grid">
        {[
          { target: 24,  suffix: 'h',  label: 'Réponse garantie',      i18n: 'why.kpi.response'  },
          { target: 15,  suffix: '+',  label: 'Clients servis',         i18n: 'why.kpi.clients'   },
          { target: 100, suffix: '%',  label: 'Satisfaction client',    i18n: 'why.kpi.sat'       },
        ].map((kpi, ki) => (
          <div class="kpi-card reveal" style={`transition-delay:${ki * 0.12}s`}
               data-target={kpi.target} data-suffix={kpi.suffix}>
            <div class="kpi-val">
              <span class="kpi-num">0</span><span class="kpi-suffix">{kpi.suffix}</span>
            </div>
            <p class="kpi-label" data-i18n={kpi.i18n}>{kpi.label}</p>
          </div>
        ))}
      </div>

      <div class="why-cta reveal" style="text-align:center; margin-top:3rem;">
        <a href="/qui-sommes-nous" class="btn btn--outline" data-i18n="why.separator">{t.why.separator}</a>
      </div>
    </div>
  </section>

  <!-- ═══ CTA FINALE ═══ -->
  <section class="section cta-final">
    <div class="cta-final__blob cta-final__blob--1" aria-hidden="true"></div>
    <div class="cta-final__blob cta-final__blob--2" aria-hidden="true"></div>
    <div class="container cta-final__inner">
      <div class="reveal" style="text-align:center;">
        <span class="eyebrow eyebrow--blanc" data-i18n="cta.eyebrow">{t.cta.eyebrow}</span>
        <h2 class="titre-section titre-section--clair" style="margin:.5rem 0 .8rem;">
          <span data-i18n="cta.title.0">{t.cta.title[0]}</span><br />
          <span data-i18n="cta.title.1">{t.cta.title[1]}</span>
        </h2>
        <p class="sous-titre sous-titre--clair" style="margin:.8rem auto 0; text-align:center;"
           data-i18n="cta.desc">{t.cta.desc}</p>
        <div class="cta-final__btns">
          <a href="/devis"   class="btn btn--primaire"      data-i18n="cta.primary">{t.cta.primary}</a>
          <a href="/contact" class="btn btn--outline-blanc" data-i18n="cta.secondary">{t.cta.secondary}</a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<script>
  /* ── TIMELINE SCROLL ANIMATION ── */
  const timeline = document.getElementById('timeline');
  const fill     = document.getElementById('timelineFill');
  const steps    = Array.from(document.querySelectorAll<HTMLElement>('.timeline__step'));

  if (timeline && fill) {
    const updateTimeline = () => {
      const rect = timeline.getBoundingClientRect();
      const winH  = window.innerHeight;
      const progress = Math.max(0, Math.min(1,
        (winH * 0.6 - rect.top) / rect.height
      ));
      fill.style.height = `${progress * 100}%`;
    };

    window.addEventListener('scroll', updateTimeline, { passive: true });
    updateTimeline();
  }

  /* IntersectionObserver — révèle chaque étape (ring + carte) */
  const stepObs = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        stepObs.unobserve(e.target);
      }
    }),
    { threshold: 0.35 }
  );
  steps.forEach((s) => stepObs.observe(s));

  /* ── PROCESS TITLE WORD REVEAL ── */
  const procTitle = document.querySelector('.process-title-reveal');
  if (procTitle) {
    const procObs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        procTitle.querySelectorAll<HTMLElement>('.proc-word').forEach(w => {
          const delay = parseFloat(w.dataset.delay ?? '0');
          setTimeout(() => w.classList.add('proc-word--vis'), delay * 1000);
        });
        procObs.disconnect();
      }
    }, { threshold: 0.5 });
    procObs.observe(procTitle);
  }

  /* ── MINI GLOBE CANVAS (carte web) ── */
  const miniGlobe = document.getElementById('miniGlobe') as HTMLCanvasElement;
  if (miniGlobe) {
    const ctx = miniGlobe.getContext('2d')!;
    const W = 110, H = 110, cx = 55, cy = 55, R = 44;
    let rot = 0;

    function drawMiniGlobe() {
      ctx.clearRect(0, 0, W, H);

      /* Fond de sphère — plus bleu/vivid */
      const bg = ctx.createRadialGradient(cx - 16, cy - 16, 4, cx, cy, R);
      bg.addColorStop(0,   'rgba(107,145,212,.18)');
      bg.addColorStop(0.45,'rgba(74,112,192,.10)');
      bg.addColorStop(1,   'rgba(7,13,26,.4)');
      ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.fillStyle = bg; ctx.fill();

      /* Contour bleu */
      ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(107,145,212,.8)'; ctx.lineWidth = 0.8; ctx.stroke();

      /* Clip sur la sphère */
      ctx.save();
      ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.clip();

      /* Parallèles */
      [-55, -28, 0, 28, 55].forEach(lat => {
        const y    = cy + R * Math.sin(lat * Math.PI / 180);
        const rLat = R * Math.cos(lat * Math.PI / 180);
        ctx.beginPath();
        ctx.ellipse(cx, y, rLat, rLat * 0.26, 0, 0, Math.PI * 2);
        ctx.strokeStyle = lat === 0 ? 'rgba(107,180,255,.75)' : 'rgba(107,180,255,.45)';
        ctx.lineWidth = lat === 0 ? 1 : 0.7;
        ctx.stroke();
      });

      /* Méridiens rotatifs */
      for (let lon = 0; lon < 180; lon += 30) {
        const a  = (lon * Math.PI / 180) + rot;
        const rx = Math.abs(R * Math.cos(a));
        const op = ((Math.cos(a) + 1) / 2) * 0.55 + 0.12;
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx, R, 0, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(107,160,255,${op.toFixed(2)})`;
        ctx.lineWidth = 0.7;
        ctx.stroke();
      }

      /* Reflet lumineux */
      const hl = ctx.createRadialGradient(cx - 16, cy - 17, 1, cx - 8, cy - 8, R * 0.65);
      hl.addColorStop(0, 'rgba(255,255,255,.10)');
      hl.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = hl; ctx.fillRect(0, 0, W, H);
      ctx.restore();

      /* Halo externe bleu */
      const halo = ctx.createRadialGradient(cx, cy, R * 0.88, cx, cy, R * 1.28);
      halo.addColorStop(0, 'rgba(107,145,212,.12)');
      halo.addColorStop(1, 'rgba(107,145,212,0)');
      ctx.beginPath(); ctx.arc(cx, cy, R * 1.28, 0, Math.PI * 2);
      ctx.fillStyle = halo; ctx.fill();

      rot += 0.018;
      requestAnimationFrame(drawMiniGlobe);
    }
    drawMiniGlobe();
  }

  /* ── MINI BRAIN CANVAS (carte IA) ── */
  const miniBrain = document.getElementById('miniBrain') as HTMLCanvasElement;
  if (miniBrain) {
    const ctx = miniBrain.getContext('2d')!;
    const W = 110, H = 110;

    /* Nœuds disposés en forme de cerveau */
    const nodes = [
      { x: 55, y: 20 },   /* sommet */
      { x: 30, y: 30 },   /* haut-gauche */
      { x: 80, y: 30 },   /* haut-droite */
      { x: 18, y: 52 },   /* milieu-gauche */
      { x: 55, y: 44 },   /* centre */
      { x: 92, y: 52 },   /* milieu-droite */
      { x: 32, y: 68 },   /* bas-gauche */
      { x: 78, y: 68 },   /* bas-droite */
      { x: 55, y: 82 },   /* bas-centre */
      { x: 22, y: 85 },   /* très bas-gauche */
      { x: 88, y: 85 },   /* très bas-droite */
    ];

    /* Connexions entre nœuds */
    const edges: [number, number][] = [
      [0,1],[0,2],[1,2],
      [1,3],[2,5],
      [1,4],[2,4],[3,4],[5,4],
      [3,6],[5,7],
      [4,6],[4,7],[4,8],
      [6,8],[7,8],
      [6,9],[7,10],
      [9,8],[10,8],
    ];

    /* Chaque nœud a une phase de pulsation décalée */
    const phases = nodes.map((_, i) => (i / nodes.length) * Math.PI * 2);
    let t = 0;

    function drawMiniBrain() {
      ctx.clearRect(0, 0, W, H);

      /* Fond doux */
      const bg = ctx.createRadialGradient(55, 55, 5, 55, 55, 52);
      bg.addColorStop(0, 'rgba(107,145,212,.07)');
      bg.addColorStop(1, 'rgba(160,180,222,.02)');
      ctx.beginPath(); ctx.arc(55, 55, 52, 0, Math.PI * 2);
      ctx.fillStyle = bg; ctx.fill();

      /* Connexions */
      edges.forEach(([a, b]) => {
        const na = nodes[a], nb = nodes[b];
        /* Pulse qui voyage le long de l'arête */
        const pulse = (Math.sin(t * 1.8 + phases[a]) + 1) / 2;
        const op    = 0.12 + pulse * 0.38;
        ctx.beginPath();
        ctx.moveTo(na.x, na.y); ctx.lineTo(nb.x, nb.y);
        ctx.strokeStyle = `rgba(107,145,212,${op.toFixed(2)})`;
        ctx.lineWidth = 0.9;
        ctx.stroke();
      });

      /* Points lumineux voyageant sur les connexions */
      edges.forEach(([a, b]) => {
        const na = nodes[a], nb = nodes[b];
        const progress = ((t * 0.6 + phases[a]) % (Math.PI * 2)) / (Math.PI * 2);
        const px = na.x + (nb.x - na.x) * progress;
        const py = na.y + (nb.y - na.y) * progress;
        ctx.beginPath(); ctx.arc(px, py, 1.2, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(160,180,222,.55)';
        ctx.fill();
      });

      /* Nœuds */
      nodes.forEach((n, i) => {
        const pulse = (Math.sin(t + phases[i]) + 1) / 2;
        const r     = 2.8 + pulse * 1.4;
        const alpha = 0.45 + pulse * 0.55;

        /* Halo */
        const halo = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, r * 3.2);
        halo.addColorStop(0, `rgba(107,145,212,${(alpha * 0.3).toFixed(2)})`);
        halo.addColorStop(1, 'rgba(107,145,212,0)');
        ctx.beginPath(); ctx.arc(n.x, n.y, r * 3.2, 0, Math.PI * 2);
        ctx.fillStyle = halo; ctx.fill();

        /* Cœur */
        ctx.beginPath(); ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(160,180,222,${alpha.toFixed(2)})`;
        ctx.fill();
      });

      t += 0.12;
      requestAnimationFrame(drawMiniBrain);
    }
    drawMiniBrain();
  }

  /* ── KPI COUNTERS (démarrage explicite à 0) ── */
  const kpiCards = document.querySelectorAll<HTMLElement>('.kpi-card');
  // Reset initial visuel à 0 pour tous les compteurs
  kpiCards.forEach((c) => {
    const numEl = c.querySelector<HTMLElement>('.kpi-num');
    if (numEl) numEl.textContent = '0';
  });
  const kpiObs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const card   = e.target as HTMLElement;
      const numEl  = card.querySelector<HTMLElement>('.kpi-num');
      if (!numEl || numEl.dataset.done) return;
      numEl.dataset.done = '1';
      numEl.textContent = '0';
      const target  = parseInt(card.dataset.target ?? '0', 10);
      const dur     = 1800;
      const start   = performance.now();
      function tick(now: number) {
        const p = Math.min((now - start) / dur, 1);
        const ease = 1 - Math.pow(1 - p, 3);
        numEl!.textContent = String(Math.round(ease * target));
        if (p < 1) requestAnimationFrame(tick);
        else numEl!.textContent = String(target);
      }
      requestAnimationFrame(tick);
      kpiObs.unobserve(e.target);
    });
  }, { threshold: 0.5 });
  kpiCards.forEach((c) => kpiObs.observe(c));

  /* ── TITRES BLUR-IN ── */
  const blurTitles = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('titre-clear');
        blurTitles.unobserve(e.target);
      }
    });
  }, { threshold: 0.2 });
  document.querySelectorAll<HTMLElement>('.titre-section').forEach((t) => blurTitles.observe(t));

  /* ── TITRES CARTES EXPERTISE — typing animation mot par mot ── */
  function splitTitleIntoWords(el: HTMLElement) {
    if (el.dataset.split === '1') return;
    const text = el.textContent || '';
    el.textContent = '';
    const words = text.split(/(\s+)/);
    words.forEach((w) => {
      if (/^\s+$/.test(w)) {
        el.appendChild(document.createTextNode(w));
      } else if (w.length) {
        const span = document.createElement('span');
        span.className = 'typing-word';
        span.textContent = w;
        el.appendChild(span);
      }
    });
    el.dataset.split = '1';
  }

  const cartTitles = document.querySelectorAll<HTMLElement>('.svc-carte__titre');
  cartTitles.forEach(splitTitleIntoWords);

  // Observer la carte parente (qui reçoit .visible) — déclenche le typing en cascade
  const cardTypingObs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const card = e.target as HTMLElement;
      if (card.dataset.typed) return;
      card.dataset.typed = '1';
      const titre = card.querySelector<HTMLElement>('.svc-carte__titre');
      if (!titre) return;
      const words = titre.querySelectorAll<HTMLElement>('.typing-word');
      words.forEach((w, i) => {
        setTimeout(() => w.classList.add('is-typed'), 120 + i * 110);
      });
      cardTypingObs.unobserve(card);
    });
  }, { threshold: 0.25 });
  document.querySelectorAll<HTMLElement>('.svc-carte').forEach((c) => cardTypingObs.observe(c));
</script>

