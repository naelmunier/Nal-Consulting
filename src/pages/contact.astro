---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact — Nal Consulting">

  <section class="contact-page">
    <div class="contact-page__bg" aria-hidden="true">
      <div class="cp-blob cp-blob--1"></div>
      <div class="cp-blob cp-blob--2"></div>
      <div class="cp-dots"></div>
    </div>

    <div class="container contact-inner">

      <!-- En-tête -->
      <div class="contact-top animate-in">
        <span class="eyebrow eyebrow--blanc">Contact</span>
        <h1 class="contact-titre">
          Parlons de<br/>
          <span class="contact-titre__grad">votre projet.</span>
        </h1>
        <p class="contact-desc">
          Réponse garantie sous 24h. Aucun engagement.
        </p>
      </div>

      <!-- Grille contact -->
      <div class="contact-grid animate-in" style="animation-delay:.2s">

        <!-- Info rapide -->
        <div class="cp-info">
          <a href="mailto:contact@nalconsulting.fr" class="cp-info__card cp-info__card--email">
            <div class="cp-info__ico">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <p class="cp-info__label">Email</p>
              <p class="cp-info__val">contact@nalconsulting.fr</p>
            </div>
            <svg class="cp-info__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>

          <div class="cp-info__card">
            <div class="cp-info__ico cp-info__ico--clock">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <p class="cp-info__label">Délai de réponse</p>
              <p class="cp-info__val">Sous 24h ouvrées</p>
            </div>
          </div>

          <div class="cp-socials">
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="cp-social" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="cp-social" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              GitHub
            </a>
          </div>
        </div>

        <!-- Formulaire -->
        <div class="cp-form-wrap">
          <form
            class="cp-form"
            action="https://formspree.io/f/XXXXXXXX"
            method="POST"
            id="contactForm"
          >
            <div class="cp-form__row">
              <div class="form-group">
                <label for="nom">Nom</label>
                <input type="text" id="nom" name="nom" placeholder="Votre nom" required />
              </div>
              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="votre@email.com" required />
              </div>
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows={6} placeholder="Décrivez votre projet ou votre question..." required></textarea>
            </div>
            <button type="submit" class="btn btn--primaire cp-submit" id="contactSubmit">
              <span>Envoyer le message</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
            <p class="cp-note">Vos données restent strictement confidentielles.</p>
          </form>
        </div>

      </div>
    </div>
  </section>

</MainLayout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const btn  = document.getElementById('contactSubmit') as HTMLButtonElement;
  form?.addEventListener('submit', () => {
    if (btn) btn.disabled = true;
  });
</script>

<style>
/* ─── PAGE WRAPPER ─── */
.contact-page {
  position: relative;
  min-height: 100vh;
  background: var(--gradient-hero);
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 8rem 0 6rem;
}

.contact-page__bg { position: absolute; inset: 0; pointer-events: none; }
.cp-blob {
  position: absolute; border-radius: 50%;
  filter: blur(130px);
}
.cp-blob--1 { width: 700px; height: 700px; top: -200px; right: -150px; background: rgba(107,145,212,.12); }
.cp-blob--2 { width: 500px; height: 500px; bottom: -180px; left: -100px; background: rgba(160,180,222,.08); }
.cp-dots {
  position: absolute; inset: 0;
  background-image: radial-gradient(circle, rgba(160,180,222,.1) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
}

/* ─── INNER ─── */
.contact-inner {
  position: relative;
  max-width: 1100px;
}

/* ─── TOP ─── */
.contact-top { text-align: center; margin-bottom: 4rem; }
.contact-titre {
  font-size: clamp(3rem, 6vw, 5rem);
  font-weight: 900; color: #fff;
  letter-spacing: -.045em; line-height: 1.08;
  margin: .8rem 0 1rem;
}
.contact-titre__grad {
  background: linear-gradient(130deg, #A0B4DE 0%, #d6e6ff 50%, #A0B4DE 100%);
  background-size: 200%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  animation: gradient-shift 5s ease infinite;
}
@keyframes gradient-shift { 0%,100%{background-position:0%} 50%{background-position:100%} }

.contact-desc {
  font-size: 1.1rem; color: rgba(255,255,255,.6);
  margin: 0 auto;
}

/* ─── GRID ─── */
.contact-grid {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 2.5rem;
  align-items: start;
}

/* ─── INFO ─── */
.cp-info {
  display: flex; flex-direction: column; gap: 1rem;
}

.cp-info__card {
  display: flex; align-items: center; gap: 1rem;
  padding: 1.4rem 1.6rem;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(160,180,222,.15);
  border-radius: var(--rayon-lg);
  color: #fff; text-decoration: none;
  transition: background .25s, border-color .25s;
  position: relative;
}
.cp-info__card--email { cursor: pointer; }
.cp-info__card--email:hover {
  background: rgba(107,145,212,.15);
  border-color: rgba(107,145,212,.4);
}

.cp-info__ico {
  width: 44px; height: 44px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: rgba(107,145,212,.2);
  border-radius: var(--rayon);
  color: var(--bleu);
}
.cp-info__ico--clock { background: rgba(160,180,222,.12); color: rgba(160,180,222,.7); }

.cp-info__label {
  font-size: .72rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .08em; color: rgba(160,180,222,.55); margin-bottom: .15rem;
}
.cp-info__val {
  font-size: .9rem; font-weight: 600; color: rgba(255,255,255,.85);
}

.cp-info__arrow {
  margin-left: auto; color: rgba(107,145,212,.6);
  transition: transform .2s, color .2s;
}
.cp-info__card--email:hover .cp-info__arrow {
  transform: translateX(3px); color: var(--bleu);
}

/* Socials */
.cp-socials {
  display: flex; gap: .75rem; padding-top: .5rem;
}
.cp-social {
  display: flex; align-items: center; gap: .6rem;
  flex: 1; padding: .85rem 1rem;
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(160,180,222,.12);
  border-radius: var(--rayon);
  font-size: .85rem; font-weight: 600;
  color: rgba(255,255,255,.65);
  transition: background .2s, color .2s, border-color .2s;
}
.cp-social:hover {
  background: rgba(107,145,212,.15);
  border-color: rgba(107,145,212,.35);
  color: #fff;
}

/* ─── FORMULAIRE ─── */
.cp-form-wrap {
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(160,180,222,.15);
  border-radius: var(--rayon-xl);
  padding: 2.8rem;
  backdrop-filter: blur(20px);
}

.cp-form { display: flex; flex-direction: column; gap: 1.3rem; }
.cp-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }

/* Override form-group for dark background */
.cp-form-wrap label {
  font-size: .82rem; font-weight: 700; color: rgba(255,255,255,.7);
  text-transform: uppercase; letter-spacing: .06em;
}
.cp-form-wrap input,
.cp-form-wrap textarea {
  background: rgba(255,255,255,.07);
  border: 1.5px solid rgba(160,180,222,.2);
  color: #fff;
  border-radius: var(--rayon);
}
.cp-form-wrap input::placeholder,
.cp-form-wrap textarea::placeholder {
  color: rgba(255,255,255,.25);
}
.cp-form-wrap input:focus,
.cp-form-wrap textarea:focus {
  border-color: rgba(107,145,212,.6);
  background: rgba(107,145,212,.08);
  box-shadow: 0 0 0 3px rgba(107,145,212,.15);
  outline: none;
}

.cp-submit { width: 100%; justify-content: center; padding: 1.05rem; font-size: 1rem; }
.cp-note { font-size: .78rem; color: rgba(255,255,255,.3); text-align: center; }

/* ─── RESPONSIVE ─── */
@media (max-width: 900px) {
  .contact-grid { grid-template-columns: 1fr; }
  .cp-info { flex-direction: row; flex-wrap: wrap; }
  .cp-info__card { flex: 1 1 200px; }
  .cp-socials { flex: 1 1 100%; }
}
@media (max-width: 600px) {
  .contact-page { padding: 7rem 0 5rem; }
  .cp-form-wrap { padding: 1.8rem 1.2rem; }
  .cp-form__row { grid-template-columns: 1fr; }
  .cp-info { flex-direction: column; }
}
</style>
