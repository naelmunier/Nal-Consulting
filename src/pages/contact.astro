---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact — Nal Consulting">

  <section class="contact-page">
    <div class="contact-page__bg" aria-hidden="true">
      <div class="cp-blob cp-blob--1"></div>
      <div class="cp-blob cp-blob--2"></div>
      <div class="cp-blob cp-blob--3"></div>
      <div class="cp-dots"></div>
    </div>

    <div class="container contact-inner">

      {/* En-tête avec word-reveal */}
      <div class="contact-top">
        <span class="eyebrow eyebrow--blanc reveal-fade">— Contact</span>
        <h1 class="contact-titre">
          <span class="contact-titre__line titre-words" data-words="Parlons de"></span>
          <span class="contact-titre__line contact-titre__line--grad titre-words" data-words="votre projet."></span>
        </h1>
        <p class="contact-desc reveal-fade">
          Réponse garantie sous 24h. Aucun engagement.
        </p>
      </div>

      <div class="contact-grid">

        {/* Carte coordonnées premium */}
        <aside class="cp-card reveal-fade">
          <div class="cp-card__halo" aria-hidden="true"></div>

          <div class="cp-card__head">
            <span class="cp-card__eyebrow">— Coordonnées directes</span>
            <h2 class="cp-card__titre">
              <span class="titre-words" data-words="Joignez-nous"></span><br/>
              <span class="cp-card__titre-grad titre-words" data-words="directement."></span>
            </h2>
          </div>

          <div class="cp-card__items">
            <a href="mailto:naelmunier22@gmail.com" class="cp-item cp-item--link" aria-label="Envoyer un email">
              <div class="cp-item__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2"/>
                  <path d="M3 7l9 6 9-6"/>
                </svg>
              </div>
              <div class="cp-item__txt">
                <span class="cp-item__label">Email</span>
                <span class="cp-item__val">naelmunier22@gmail.com</span>
              </div>
              <svg class="cp-item__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>

            <a href="tel:+33621862854" class="cp-item cp-item--link" aria-label="Appeler">
              <div class="cp-item__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div class="cp-item__txt">
                <span class="cp-item__label">Téléphone</span>
                <span class="cp-item__val">06 21 86 28 54</span>
              </div>
              <svg class="cp-item__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>

            <div class="cp-item cp-item--info">
              <div class="cp-item__ico cp-item__ico--alt" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <div class="cp-item__txt">
                <span class="cp-item__label">Disponibilité</span>
                <span class="cp-item__val">Lun–Ven · 9h–19h</span>
              </div>
            </div>
          </div>

          <div class="cp-card__separator" aria-hidden="true"></div>

          <div class="cp-socials">
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="cp-social" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a href="https://github.com/naelmunier" target="_blank" rel="noopener noreferrer" class="cp-social" aria-label="GitHub">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              GitHub
            </a>
          </div>
        </aside>

        {/* Formulaire */}
        <div class="cp-form-wrap reveal-fade">
          <div class="cp-form-head">
            <span class="cp-card__eyebrow">— Ou via le formulaire</span>
            <h2 class="cp-card__titre">
              <span class="titre-words" data-words="Envoyez-moi"></span><br/>
              <span class="cp-card__titre-grad titre-words" data-words="un message."></span>
            </h2>
          </div>

          <form
            class="cp-form"
            action="https://formspree.io/f/XXXXXXXX"
            method="POST"
            id="contactForm"
          >
            <div class="cp-form__row">
              <div class="form-group">
                <label for="nom">Nom</label>
                <input type="text" id="nom" name="nom" placeholder="Votre nom" required />
              </div>
              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="votre@email.com" required />
              </div>
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows={6} placeholder="Décrivez votre projet ou votre question..." required></textarea>
            </div>
            <button type="submit" class="btn btn--primaire cp-submit" id="contactSubmit">
              <span>Envoyer le message</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
            <p class="cp-note">Vos données restent strictement confidentielles.</p>
          </form>
        </div>

      </div>
    </div>
  </section>

</MainLayout>

<script>
  // Form submit
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const btn  = document.getElementById('contactSubmit') as HTMLButtonElement | null;
  form?.addEventListener('submit', () => {
    if (btn) btn.disabled = true;
  });

  // Word reveal
  function splitIntoWords(el: HTMLElement) {
    if (el.dataset.split === '1') return;
    const text = el.dataset.words ?? el.textContent ?? '';
    el.textContent = '';
    const words = text.split(/(\s+)/);
    words.forEach((w) => {
      if (/^\s+$/.test(w)) {
        el.appendChild(document.createTextNode(w));
      } else if (w.length) {
        const span = document.createElement('span');
        span.className = 'word';
        span.textContent = w;
        el.appendChild(span);
      }
    });
    el.dataset.split = '1';
  }

  const titres = document.querySelectorAll<HTMLElement>('.titre-words');
  titres.forEach(splitIntoWords);

  // Hero immédiat
  window.addEventListener('load', () => {
    const heroLines = document.querySelectorAll<HTMLElement>('.contact-titre__line');
    heroLines.forEach((line, lineIdx) => {
      const words = line.querySelectorAll<HTMLElement>('.word');
      words.forEach((w, i) => {
        setTimeout(() => w.classList.add('is-revealed'), 200 + lineIdx * 320 + i * 80);
      });
      (line as HTMLElement).dataset.revealed = '1';
    });
  });

  // Scroll observer pour autres titres
  const titresObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        if (el.dataset.revealed === '1') return;
        el.dataset.revealed = '1';
        const words = el.querySelectorAll<HTMLElement>('.word');
        words.forEach((w, i) => {
          setTimeout(() => w.classList.add('is-revealed'), i * 70);
        });
        titresObs.unobserve(el);
      });
    },
    { threshold: 0.3, rootMargin: '0px 0px -40px 0px' }
  );
  titres.forEach((t) => {
    if (!t.classList.contains('contact-titre__line')) titresObs.observe(t);
  });

  // Reveal-fade
  const fadeEls = document.querySelectorAll<HTMLElement>('.reveal-fade');
  const fadeObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-revealed');
        fadeObs.unobserve(e.target);
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );
  fadeEls.forEach((el) => fadeObs.observe(el));
</script>

<style>
/* ─── PAGE WRAPPER ─── */
.contact-page {
  position: relative;
  min-height: 100vh;
  background: var(--gradient-hero);
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 8rem 0 6rem;
}

.contact-page__bg { position: absolute; inset: 0; pointer-events: none; }
.cp-blob {
  position: absolute; border-radius: 50%;
  filter: blur(130px);
  animation: cp-float 20s ease-in-out infinite;
}
.cp-blob--1 {
  width: 700px; height: 700px;
  top: -200px; right: -150px;
  background: rgba(107,145,212,.18);
}
.cp-blob--2 {
  width: 500px; height: 500px;
  bottom: -180px; left: -100px;
  background: rgba(160,180,222,.14);
  animation-delay: -8s;
}
.cp-blob--3 {
  width: 400px; height: 400px;
  top: 40%; left: 30%;
  background: rgba(107,145,212,.08);
  animation-delay: -14s;
}
@keyframes cp-float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33%      { transform: translate(40px, -30px) scale(1.05); }
  66%      { transform: translate(-30px, 40px) scale(0.96); }
}
.cp-dots {
  position: absolute; inset: 0;
  background-image: radial-gradient(circle, rgba(160,180,222,.1) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
}

/* ─── INNER ─── */
.contact-inner {
  position: relative;
  max-width: 1180px;
  z-index: 2;
}

/* ─── WORD REVEAL ─── */
.word {
  display: inline-block;
  opacity: 0;
  transform: translateY(22px);
  filter: blur(8px);
  transition:
    opacity .65s cubic-bezier(.23,1,.32,1),
    transform .65s cubic-bezier(.23,1,.32,1),
    filter .65s cubic-bezier(.23,1,.32,1);
}
.word.is-revealed {
  opacity: 1;
  transform: translateY(0);
  filter: blur(0);
}

.reveal-fade {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity .85s ease, transform .85s ease;
}
.reveal-fade.is-revealed {
  opacity: 1;
  transform: translateY(0);
}

/* ─── TOP ─── */
.contact-top { text-align: center; margin-bottom: 4rem; }
.contact-titre {
  font-size: clamp(2.6rem, 6vw, 5rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -.045em;
  line-height: 1.05;
  margin: .8rem 0 1rem;
}
.contact-titre__line { display: block; }
.contact-titre__line--grad,
.cp-card__titre-grad {
  background: linear-gradient(100deg,
    #6B91D4 0%, #A0B4DE 25%, #c8d8f0 50%, #A0B4DE 75%, #6B91D4 100%);
  background-size: 220% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  animation: gradient-shift 5s ease-in-out infinite;
}
@keyframes gradient-shift {
  0%, 100% { background-position: 0% 50%; }
  50%      { background-position: 100% 50%; }
}

.contact-desc {
  font-size: 1.1rem;
  color: rgba(255,255,255,.6);
  margin: 0 auto;
}

/* ─── GRID ─── */
.contact-grid {
  display: grid;
  grid-template-columns: 0.85fr 1fr;
  gap: 2rem;
  align-items: stretch;
}

/* ─── CARTE COORDONNÉES PREMIUM ─── */
.cp-card {
  position: relative;
  padding: 2.4rem 2rem 2rem;
  border-radius: var(--rayon-xl);
  background:
    linear-gradient(155deg, rgba(160,180,222,.1), rgba(107,145,212,.04));
  border: 1px solid rgba(160,180,222,.22);
  backdrop-filter: blur(16px);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.cp-card__halo {
  position: absolute;
  width: 360px; height: 360px;
  top: -120px; right: -120px;
  background: radial-gradient(circle, rgba(160,180,222,.25), transparent 65%);
  filter: blur(50px);
  border-radius: 50%;
  pointer-events: none;
  animation: cp-float 14s ease-in-out infinite;
}

.cp-card__head { margin-bottom: 1.8rem; position: relative; z-index: 2; }
.cp-card__eyebrow {
  display: block;
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: .3em;
  text-transform: uppercase;
  color: rgba(160,180,222,.65);
  margin-bottom: .8rem;
}
.cp-card__titre {
  font-size: clamp(1.5rem, 2.8vw, 2rem);
  font-weight: 800;
  letter-spacing: -.025em;
  line-height: 1.1;
  color: #fff;
}

.cp-card__items {
  display: flex;
  flex-direction: column;
  gap: .8rem;
  position: relative;
  z-index: 2;
}

.cp-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.1rem;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(160,180,222,.15);
  border-radius: var(--rayon);
  color: #fff;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  transition: all .35s cubic-bezier(.23,1,.32,1);
}
.cp-item::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(107,145,212,.15), transparent 60%);
  opacity: 0;
  transition: opacity .35s ease;
}
.cp-item--link { cursor: pointer; }
.cp-item--link:hover {
  background: rgba(107,145,212,.1);
  border-color: rgba(107,145,212,.45);
  transform: translateX(4px);
  box-shadow: 0 12px 30px rgba(13,24,48,.35);
}
.cp-item--link:hover::before { opacity: 1; }
.cp-item--link:hover .cp-item__ico {
  transform: scale(1.08) rotate(-4deg);
  background: linear-gradient(135deg, rgba(107,145,212,.4), rgba(160,180,222,.2));
  color: #fff;
}
.cp-item--link:hover .cp-item__arrow {
  opacity: 1;
  transform: translateX(2px);
  color: var(--bleu-clair);
}

.cp-item__ico {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(107,145,212,.22), rgba(160,180,222,.08));
  border: 1px solid rgba(160,180,222,.18);
  border-radius: 12px;
  color: var(--bleu);
  transition: all .4s cubic-bezier(.23,1,.32,1);
  position: relative;
  z-index: 2;
}
.cp-item__ico svg {
  width: 22px;
  height: 22px;
}
.cp-item__ico--alt {
  background: rgba(160,180,222,.08);
  color: rgba(160,180,222,.6);
}

.cp-item__txt {
  display: flex;
  flex-direction: column;
  gap: .15rem;
  flex: 1;
  position: relative;
  z-index: 2;
  min-width: 0;
}
.cp-item__label {
  font-size: .68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .2em;
  color: rgba(160,180,222,.55);
}
.cp-item__val {
  font-size: .98rem;
  font-weight: 600;
  color: rgba(255,255,255,.92);
  letter-spacing: -.005em;
  word-break: break-all;
}

.cp-item__arrow {
  width: 18px;
  height: 18px;
  margin-left: auto;
  color: rgba(107,145,212,.55);
  opacity: 0.6;
  transition: all .35s ease;
  flex-shrink: 0;
  z-index: 2;
}

.cp-card__separator {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(160,180,222,.25), transparent);
  margin: 1.6rem 0 1.2rem;
  position: relative;
  z-index: 2;
}

/* Socials */
.cp-socials {
  display: flex;
  gap: .7rem;
  position: relative;
  z-index: 2;
}
.cp-social {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .55rem;
  flex: 1;
  padding: .8rem 1rem;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(160,180,222,.12);
  border-radius: var(--rayon);
  font-size: .85rem;
  font-weight: 600;
  color: rgba(255,255,255,.7);
  text-decoration: none;
  transition: all .35s ease;
}
.cp-social:hover {
  background: rgba(107,145,212,.15);
  border-color: rgba(107,145,212,.4);
  color: #fff;
  transform: translateY(-2px);
}

/* ─── FORMULAIRE ─── */
.cp-form-wrap {
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(160,180,222,.18);
  border-radius: var(--rayon-xl);
  padding: 2.4rem 2.2rem;
  backdrop-filter: blur(20px);
}

.cp-form-head { margin-bottom: 1.8rem; }

.cp-form { display: flex; flex-direction: column; gap: 1.2rem; }
.cp-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }

.cp-form-wrap label {
  font-size: .8rem;
  font-weight: 700;
  color: rgba(255,255,255,.7);
  text-transform: uppercase;
  letter-spacing: .08em;
}
.cp-form-wrap input,
.cp-form-wrap textarea {
  background: rgba(255,255,255,.06);
  border: 1.5px solid rgba(160,180,222,.18);
  color: #fff;
  border-radius: var(--rayon);
  padding: .95rem 1.1rem;
  font-size: .95rem;
  font-family: inherit;
  transition: all .3s ease;
}
.cp-form-wrap input::placeholder,
.cp-form-wrap textarea::placeholder {
  color: rgba(255,255,255,.28);
}
.cp-form-wrap input:focus,
.cp-form-wrap textarea:focus {
  border-color: rgba(107,145,212,.6);
  background: rgba(107,145,212,.08);
  box-shadow: 0 0 0 3px rgba(107,145,212,.15);
  outline: none;
}

.cp-submit { width: 100%; justify-content: center; padding: 1.05rem; font-size: 1rem; }
.cp-note { font-size: .78rem; color: rgba(255,255,255,.32); text-align: center; }

/* ─── RESPONSIVE ─── */
@media (max-width: 980px) {
  .contact-grid { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .contact-page { padding: 7rem 0 5rem; }
  .cp-card,
  .cp-form-wrap { padding: 1.8rem 1.4rem; }
  .cp-form__row { grid-template-columns: 1fr; }
  .cp-socials { flex-direction: column; }
}
</style>
