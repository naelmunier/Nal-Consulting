---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Merci — Nal Consulting">
  <section class="thanks-page">
    <div class="thanks-page__bg" aria-hidden="true">
      <div class="thanks-blob thanks-blob--1"></div>
      <div class="thanks-blob thanks-blob--2"></div>
    </div>

    <div class="container thanks-inner">
      <div class="thanks-icon" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none">
          <circle cx="32" cy="32" r="30" stroke="url(#g1)" stroke-width="2" fill="rgba(160,180,222,.08)"/>
          <path d="M20 33 L28 41 L44 23" stroke="url(#g1)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
            <animate attributeName="stroke-dasharray" from="0,60" to="60,0" dur="0.8s" fill="freeze"/>
          </path>
          <defs>
            <linearGradient id="g1" x1="0" y1="0" x2="64" y2="64">
              <stop offset="0%" stop-color="#A0B4DE"/>
              <stop offset="100%" stop-color="#6B91D4"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <span class="eyebrow eyebrow--blanc">— Confirmation</span>
      <h1 class="thanks-titre">
        Message bien reçu.<br/>
        <span class="thanks-titre__grad">Je reviens vers vous très vite.</span>
      </h1>
      <p class="thanks-desc">
        Merci pour votre demande. Je traite chaque message personnellement et vous répondrai sous 24h ouvrées.
        Pour aller plus vite, vous pouvez aussi réserver un créneau directement.
      </p>

      <div class="thanks-actions">
        <a href="https://calendly.com/muniernael/30min" target="_blank" rel="noopener noreferrer" class="btn btn--primaire">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <span>Réserver 30 min</span>
        </a>
        <a href="/" class="btn btn--ghost">
          <span>Retour à l'accueil</span>
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
.thanks-page {
  position: relative;
  min-height: 80vh;
  padding: 8rem 0 6rem;
  background: linear-gradient(135deg, #070d1a 0%, #0d1830 60%, #1a2e50 100%);
  color: #fff;
  overflow: hidden;
  display: flex; align-items: center;
}
.thanks-page__bg { position: absolute; inset: 0; pointer-events: none; }
.thanks-blob {
  position: absolute; border-radius: 50%; filter: blur(80px); opacity: .35;
}
.thanks-blob--1 { width: 500px; height: 500px; top: -200px; left: -100px;
  background: radial-gradient(circle, #A0B4DE 0%, transparent 70%); }
.thanks-blob--2 { width: 400px; height: 400px; bottom: -150px; right: -80px;
  background: radial-gradient(circle, #6B91D4 0%, transparent 70%); }
.thanks-inner {
  position: relative; z-index: 1;
  text-align: center;
  max-width: 700px;
  display: flex; flex-direction: column; align-items: center;
  gap: 1.2rem;
}
.thanks-icon { width: 80px; height: 80px; margin-bottom: .8rem; }
.thanks-titre {
  font-size: clamp(2rem, 5vw, 3.4rem);
  font-weight: 900; letter-spacing: -.035em; line-height: 1.08;
  margin: 0;
}
.thanks-titre__grad {
  background: linear-gradient(120deg, #A0B4DE 0%, #d6e6ff 50%, #A0B4DE 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
}
.thanks-desc {
  font-size: 1.05rem; line-height: 1.65;
  color: rgba(255,255,255,.78);
  max-width: 560px;
}
.thanks-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1rem; }
.btn--ghost {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: 1rem 1.6rem;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.18);
  color: #fff;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 600;
  transition: background .3s ease, transform .3s ease;
}
.btn--ghost:hover { background: rgba(255,255,255,.12); transform: translateY(-2px); }

@media (max-width: 600px) {
  .thanks-page { padding: 6rem 0 4rem; }
  .thanks-actions { flex-direction: column; width: 100%; max-width: 320px; }
  .thanks-actions a { width: 100%; justify-content: center; }
}
</style>
