---
/* ═══════════════════════════════════════════════
   PAGE DEVIS — sélection service + formulaires guidés
   ═══════════════════════════════════════════════ */
import MainLayout from '../layouts/MainLayout.astro';
import { translations } from '../i18n/translations';
const t  = translations.fr;
const tq = t.quote;
---

<MainLayout title="Demander un devis — Nal Consulting">

  <!-- ═══ EN-TÊTE SIMPLE (remplace l'ancien hero sombre) ═══ -->
  <section class="devis-intro">
    <div class="container devis-intro__inner animate-in">
      <h1 class="devis-intro__titre" data-i18n="quote.intro.title">{tq.intro.title}</h1>
      <p class="devis-intro__sub" data-i18n="quote.intro.sub">{tq.intro.sub}</p>
    </div>
  </section>

  <!-- ═══ GRILLE 3 CARTES SERVICES ═══ -->
  <section class="section services-picker" id="pickerSection">
    <div class="container">
      <div class="services-grid" id="servicesGrid">

        <!-- Carte WEB -->
        <article
          class="svc-card"
          data-service="web"
          role="button"
          tabindex="0"
          aria-label="Sélectionner Sites Internet & SEO"
        >
          <div class="svc-card__icon svc-card__icon--web">
            <!-- Icône globe SVG propre -->
            <svg viewBox="0 0 64 64" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="32" cy="32" r="22"/>
              <ellipse cx="32" cy="32" rx="22" ry="10"/>
              <ellipse cx="32" cy="32" rx="10" ry="22"/>
              <line x1="10" y1="32" x2="54" y2="32"/>
              <line x1="32" y1="10" x2="32" y2="54"/>
            </svg>
          </div>
          <div class="svc-card__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 class="svc-card__titre" data-i18n="quote.cards.0.title">{tq.cards[0].title}</h3>
          <p class="svc-card__desc" data-i18n="quote.cards.0.desc">{tq.cards[0].desc}</p>
          <div class="svc-card__tags">
            <span data-i18n="quote.cards.0.tag1">{tq.cards[0].tag1}</span><span data-i18n="quote.cards.0.tag2">{tq.cards[0].tag2}</span><span data-i18n="quote.cards.0.tag3">{tq.cards[0].tag3}</span>
          </div>
          <span class="svc-card__cta" data-i18n="quote.selectCta">{tq.selectCta}</span>
        </article>

        <!-- Carte DATA -->
        <article
          class="svc-card"
          data-service="data"
          role="button"
          tabindex="0"
          aria-label="Sélectionner Reporting & Data Analytics"
        >
          <div class="svc-card__icon svc-card__icon--data">
            <!-- Icône barres SVG -->
            <svg viewBox="0 0 64 64" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="8" y1="54" x2="56" y2="54"/>
              <rect x="12" y="34" width="8" height="20" rx="1.5"/>
              <rect x="24" y="22" width="8" height="32" rx="1.5"/>
              <rect x="36" y="28" width="8" height="26" rx="1.5"/>
              <rect x="48" y="14" width="8" height="40" rx="1.5"/>
            </svg>
          </div>
          <div class="svc-card__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 class="svc-card__titre" data-i18n="quote.cards.1.title">{tq.cards[1].title}</h3>
          <p class="svc-card__desc" data-i18n="quote.cards.1.desc">{tq.cards[1].desc}</p>
          <div class="svc-card__tags">
            <span data-i18n="quote.cards.1.tag1">{tq.cards[1].tag1}</span><span data-i18n="quote.cards.1.tag2">{tq.cards[1].tag2}</span><span data-i18n="quote.cards.1.tag3">{tq.cards[1].tag3}</span>
          </div>
          <span class="svc-card__cta" data-i18n="quote.selectCta">{tq.selectCta}</span>
        </article>

        <!-- Carte IA -->
        <article
          class="svc-card"
          data-service="ia"
          role="button"
          tabindex="0"
          aria-label="Sélectionner Automatisations & Agents IA"
        >
          <div class="svc-card__icon svc-card__icon--ia">
            <!-- Icône cerveau / noeuds SVG -->
            <svg viewBox="0 0 64 64" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="32" cy="14" r="4"/>
              <circle cx="14" cy="30" r="4"/>
              <circle cx="50" cy="30" r="4"/>
              <circle cx="22" cy="50" r="4"/>
              <circle cx="42" cy="50" r="4"/>
              <circle cx="32" cy="32" r="4"/>
              <line x1="32" y1="18" x2="32" y2="28"/>
              <line x1="18" y1="30" x2="28" y2="32"/>
              <line x1="46" y1="30" x2="36" y2="32"/>
              <line x1="24" y1="46" x2="30" y2="36"/>
              <line x1="40" y1="46" x2="34" y2="36"/>
              <line x1="18" y1="32" x2="20" y2="46"/>
              <line x1="46" y1="32" x2="44" y2="46"/>
            </svg>
          </div>
          <div class="svc-card__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 class="svc-card__titre" data-i18n="quote.cards.2.title">{tq.cards[2].title}</h3>
          <p class="svc-card__desc" data-i18n="quote.cards.2.desc">{tq.cards[2].desc}</p>
          <div class="svc-card__tags">
            <span data-i18n="quote.cards.2.tag1">{tq.cards[2].tag1}</span><span data-i18n="quote.cards.2.tag2">{tq.cards[2].tag2}</span><span data-i18n="quote.cards.2.tag3">{tq.cards[2].tag3}</span>
          </div>
          <span class="svc-card__cta" data-i18n="quote.selectCta">{tq.selectCta}</span>
        </article>

      </div>
    </div>
  </section>

  <!-- ═══ ZONE FORMULAIRE (révélée après sélection) ═══ -->
  <section class="section devis-section" id="formSection" aria-hidden="true">
    <div class="container">

      <!-- Lien retour sélection -->
      <button type="button" class="back-link" id="backLink">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        <span data-i18n="quote.backLink">{tq.backLink}</span>
      </button>

      <div class="devis-layout">

        <!-- COLONNE FORMULAIRES -->
        <div class="forms-col">

          <!-- ── FORM : WEB ── -->
          <form
            class="devis-form"
            data-form="web"
            action="https://formspree.io/f/XXXXXXXX"
            method="POST"
            hidden
          >
            <input type="hidden" name="service" value="web" />
            <h2 class="form-titre" data-i18n="quote.web.title">{tq.web.title}</h2>
            <p class="form-sub" data-i18n="quote.web.sub">{tq.web.sub}</p>

            <div class="form-row">
              <div class="form-group">
                <label for="web-prenom" data-i18n="quote.web.fields.firstname">{tq.web.fields.firstname}</label>
                <input type="text" id="web-prenom" name="prenom" placeholder={tq.web.fields.firstnamePh} data-i18n-placeholder="quote.web.fields.firstnamePh" required />
              </div>
              <div class="form-group">
                <label for="web-nom" data-i18n="quote.web.fields.lastname">{tq.web.fields.lastname}</label>
                <input type="text" id="web-nom" name="nom" placeholder={tq.web.fields.lastnamePh} data-i18n-placeholder="quote.web.fields.lastnamePh" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="web-email" data-i18n="quote.web.fields.email">{tq.web.fields.email}</label>
                <input type="email" id="web-email" name="email" placeholder={tq.web.fields.emailPh} data-i18n-placeholder="quote.web.fields.emailPh" required />
              </div>
              <div class="form-group">
                <label for="web-tel"><span data-i18n="quote.web.fields.phone">{tq.web.fields.phone}</span> <span class="form-optionnel" data-i18n="quote.web.fields.phoneOpt">{tq.web.fields.phoneOpt}</span></label>
                <input type="tel" id="web-tel" name="telephone" placeholder={tq.web.fields.phonePh} data-i18n-placeholder="quote.web.fields.phonePh" />
              </div>
            </div>

            <div class="form-group">
              <label for="web-entreprise" data-i18n="quote.web.fields.company">{tq.web.fields.company}</label>
              <input type="text" id="web-entreprise" name="entreprise" placeholder={tq.web.fields.companyPh} data-i18n-placeholder="quote.web.fields.companyPh" />
            </div>

            <div class="form-group">
              <label data-i18n="quote.web.fields.typeLabel">{tq.web.fields.typeLabel}</label>
              <div class="radio-cards">
                {tq.web.fields.typeOptions.map((v, i) => (
                  <label class="radio-card">
                    <input type="radio" name="type_site" value={v} required={i === 0} />
                    <span class="radio-card__inner" data-i18n={`quote.web.fields.typeOptions.${i}`}>{v}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="web-objectif" data-i18n="quote.web.fields.objective">{tq.web.fields.objective}</label>
                <div class="select-wrap">
                  <select id="web-objectif" name="objectif">
                    <option value="" disabled selected data-i18n="quote.web.fields.objectiveChoose">{tq.web.fields.objectiveChoose}</option>
                    {tq.web.fields.objectiveOptions.map((v, i) => (
                      <option data-i18n={`quote.web.fields.objectiveOptions.${i}`}>{v}</option>
                    ))}
                  </select>
                  <svg class="select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>
              <div class="form-group">
                <label for="web-pages" data-i18n="quote.web.fields.pages">{tq.web.fields.pages}</label>
                <div class="select-wrap">
                  <select id="web-pages" name="nb_pages">
                    <option value="" disabled selected data-i18n="quote.web.fields.pagesChoose">{tq.web.fields.pagesChoose}</option>
                    {tq.web.fields.pagesOptions.map((v) => (
                      <option>{v}</option>
                    ))}
                  </select>
                  <svg class="select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label data-i18n="quote.web.fields.seoLabel">{tq.web.fields.seoLabel}</label>
              <div class="toggle-row">
                {tq.web.fields.seoOptions.map((v, i) => (
                  <label class="toggle-pill">
                    <input type="radio" name="seo" value={v} checked={i === 0} />
                    <span data-i18n={`quote.web.fields.seoOptions.${i}`}>{v}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-group">
              <label for="web-budget" data-i18n="quote.web.fields.budget">{tq.web.fields.budget}</label>
              <div class="select-wrap">
                <select id="web-budget" name="budget">
                  <option value="" disabled selected data-i18n="quote.web.fields.budgetPh">{tq.web.fields.budgetPh}</option>
                  {tq.budgets.map((b, i) => (
                    <option value={b.value} data-i18n={`quote.budgets.${i}.label`}>{b.label}</option>
                  ))}
                </select>
                <svg class="select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>

            <div class="form-group">
              <label for="web-desc" data-i18n="quote.web.fields.desc">{tq.web.fields.desc}</label>
              <textarea id="web-desc" name="description" rows="5" placeholder={tq.web.fields.descPh} data-i18n-placeholder="quote.web.fields.descPh" required></textarea>
            </div>

            <button type="submit" class="btn btn--primaire devis-submit">
              <span data-i18n="quote.submit">{tq.submit}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
            <p class="devis-note" data-i18n="quote.note">{tq.note}</p>
          </form>

          <!-- ── FORM : DATA ── -->
          <form
            class="devis-form"
            data-form="data"
            action="https://formspree.io/f/XXXXXXXX"
            method="POST"
            hidden
          >
            <input type="hidden" name="service" value="data" />
            <h2 class="form-titre" data-i18n="quote.data.title">{tq.data.title}</h2>
            <p class="form-sub" data-i18n="quote.data.sub">{tq.data.sub}</p>

            <div class="form-row">
              <div class="form-group">
                <label for="data-prenom" data-i18n="quote.data.fields.firstname">{tq.data.fields.firstname}</label>
                <input type="text" id="data-prenom" name="prenom" placeholder={tq.data.fields.firstnamePh} data-i18n-placeholder="quote.data.fields.firstnamePh" required />
              </div>
              <div class="form-group">
                <label for="data-nom" data-i18n="quote.data.fields.lastname">{tq.data.fields.lastname}</label>
                <input type="text" id="data-nom" name="nom" placeholder={tq.data.fields.lastnamePh} data-i18n-placeholder="quote.data.fields.lastnamePh" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="data-email" data-i18n="quote.data.fields.email">{tq.data.fields.email}</label>
                <input type="email" id="data-email" name="email" placeholder={tq.data.fields.emailPh} data-i18n-placeholder="quote.data.fields.emailPh" required />
              </div>
              <div class="form-group">
                <label for="data-tel"><span data-i18n="quote.data.fields.phone">{tq.data.fields.phone}</span> <span class="form-optionnel" data-i18n="quote.data.fields.phoneOpt">{tq.data.fields.phoneOpt}</span></label>
                <input type="tel" id="data-tel" name="telephone" placeholder={tq.data.fields.phonePh} data-i18n-placeholder="quote.data.fields.phonePh" />
              </div>
            </div>

            <div class="form-group">
              <label for="data-entreprise" data-i18n="quote.data.fields.company">{tq.data.fields.company}</label>
              <input type="text" id="data-entreprise" name="entreprise" placeholder={tq.data.fields.companyPh} data-i18n-placeholder="quote.data.fields.companyPh" />
            </div>

            <div class="form-group">
              <label data-i18n="quote.data.fields.sourcesLabel">{tq.data.fields.sourcesLabel}</label>
              <div class="chips-group">
                {tq.data.fields.sourcesOptions.map((v, i) => (
                  <label class="chip">
                    <input type="checkbox" name="sources" value={v} />
                    <span data-i18n={`quote.data.fields.sourcesOptions.${i}`}>{v}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-group">
              <label data-i18n="quote.data.fields.toolLabel">{tq.data.fields.toolLabel}</label>
              <div class="radio-cards">
                {tq.data.fields.toolOptions.map((v, i) => (
                  <label class="radio-card">
                    <input type="radio" name="outil" value={v} required={i === 0} />
                    <span class="radio-card__inner" data-i18n={`quote.data.fields.toolOptions.${i}`}>{v}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="data-volume" data-i18n="quote.data.fields.volume">{tq.data.fields.volume}</label>
                <div class="select-wrap">
                  <select id="data-volume" name="volume">
                    <option value="" disabled selected data-i18n="quote.data.fields.volumeChoose">{tq.data.fields.volumeChoose}</option>
                    {tq.data.fields.volumeOptions.map((v, i) => (
                      <option data-i18n={`quote.data.fields.volumeOptions.${i}`}>{v}</option>
                    ))}
                  </select>
                  <svg class="select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>
              <div class="form-group">
                <label for="data-freq" data-i18n="quote.data.fields.freq">{tq.data.fields.freq}</label>
                <div class="select-wrap">
                  <select id="data-freq" name="frequence">
                    <option value="" disabled selected data-i18n="quote.data.fields.freqChoose">{tq.data.fields.freqChoose}</option>
                    {tq.data.fields.freqOptions.map((v, i) => (
                      <option data-i18n={`quote.data.fields.freqOptions.${i}`}>{v}</option>
                    ))}
                  </select>
                  <svg class="select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label for="data-budget" data-i18n="quote.data.fields.budget">{tq.data.fields.budget}</label>
              <div class="select-wrap">
                <select id="data-budget" name="budget">
                  <option value="" disabled selected data-i18n="quote.data.fields.budgetPh">{tq.data.fields.budgetPh}</option>
                  {tq.budgets.map((b, i) => (
                    <option value={b.value} data-i18n={`quote.budgets.${i}.label`}>{b.label}</option>
                  ))}
                </select>
                <svg class="select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>

            <div class="form-group">
              <label for="data-desc" data-i18n="quote.data.fields.desc">{tq.data.fields.desc}</label>
              <textarea id="data-desc" name="description" rows="5" placeholder={tq.data.fields.descPh} data-i18n-placeholder="quote.data.fields.descPh" required></textarea>
            </div>

            <button type="submit" class="btn btn--primaire devis-submit">
              <span data-i18n="quote.submit">{tq.submit}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
            <p class="devis-note" data-i18n="quote.note">{tq.note}</p>
          </form>

          <!-- ── FORM : IA ── -->
          <form
            class="devis-form"
            data-form="ia"
            action="https://formspree.io/f/XXXXXXXX"
            method="POST"
            hidden
          >
            <input type="hidden" name="service" value="ia" />
            <h2 class="form-titre" data-i18n="quote.ia.title">{tq.ia.title}</h2>
            <p class="form-sub" data-i18n="quote.ia.sub">{tq.ia.sub}</p>

            <div class="form-row">
              <div class="form-group">
                <label for="ia-prenom" data-i18n="quote.ia.fields.firstname">{tq.ia.fields.firstname}</label>
                <input type="text" id="ia-prenom" name="prenom" placeholder={tq.ia.fields.firstnamePh} data-i18n-placeholder="quote.ia.fields.firstnamePh" required />
              </div>
              <div class="form-group">
                <label for="ia-nom" data-i18n="quote.ia.fields.lastname">{tq.ia.fields.lastname}</label>
                <input type="text" id="ia-nom" name="nom" placeholder={tq.ia.fields.lastnamePh} data-i18n-placeholder="quote.ia.fields.lastnamePh" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="ia-email" data-i18n="quote.ia.fields.email">{tq.ia.fields.email}</label>
                <input type="email" id="ia-email" name="email" placeholder={tq.ia.fields.emailPh} data-i18n-placeholder="quote.ia.fields.emailPh" required />
              </div>
              <div class="form-group">
                <label for="ia-tel"><span data-i18n="quote.ia.fields.phone">{tq.ia.fields.phone}</span> <span class="form-optionnel" data-i18n="quote.ia.fields.phoneOpt">{tq.ia.fields.phoneOpt}</span></label>
                <input type="tel" id="ia-tel" name="telephone" placeholder={tq.ia.fields.phonePh} data-i18n-placeholder="quote.ia.fields.phonePh" />
              </div>
            </div>

            <div class="form-group">
              <label for="ia-entreprise" data-i18n="quote.ia.fields.company">{tq.ia.fields.company}</label>
              <input type="text" id="ia-entreprise" name="entreprise" placeholder={tq.ia.fields.companyPh} data-i18n-placeholder="quote.ia.fields.companyPh" />
            </div>

            <div class="form-group">
              <label data-i18n="quote.ia.fields.typeLabel">{tq.ia.fields.typeLabel}</label>
              <div class="radio-cards">
                {tq.ia.fields.typeOptions.map((v, i) => (
                  <label class="radio-card">
                    <input type="radio" name="type_auto" value={v} required={i === 0} />
                    <span class="radio-card__inner" data-i18n={`quote.ia.fields.typeOptions.${i}`}>{v}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-group">
              <label for="ia-tache" data-i18n="quote.ia.fields.task">{tq.ia.fields.task}</label>
              <textarea id="ia-tache" name="tache" rows="3" placeholder={tq.ia.fields.taskPh} data-i18n-placeholder="quote.ia.fields.taskPh" required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="ia-volume" data-i18n="quote.ia.fields.volume">{tq.ia.fields.volume}</label>
