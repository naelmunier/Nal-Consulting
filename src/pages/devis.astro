<script>
  /* ─────────────────────────────────────────────
     SÉLECTION CARTE + RÉVÉLATION FORMULAIRE
  ───────────────────────────────────────────── */
  const cards   = Array.from(document.querySelectorAll<HTMLElement>('.svc-card'));
  const forms   = Array.from(document.querySelectorAll<HTMLFormElement>('.devis-form'));
  const formSec = document.getElementById('formSection') as HTMLElement;
  const backBtn = document.getElementById('backLink') as HTMLButtonElement;
  const picker  = document.getElementById('pickerSection') as HTMLElement;

  /**
   * Sélectionne un service, affiche le bon formulaire et
   * révèle la section avec un scroll fluide.
   */
  function selectService(svc: string) {
    // Etat visuel des cartes
    cards.forEach((c) => {
      c.classList.toggle('svc-card--selected', c.dataset.service === svc);
    });

    // Mode compact : on masque les cartes non sélectionnées
    picker.classList.add('services-picker--compact');

    // Affichage du bon formulaire
    forms.forEach((f) => {
      const match = f.dataset.form === svc;
      f.hidden = !match;
    });

    // Révélation de la section formulaire
    formSec.classList.add('form-visible');
    formSec.removeAttribute('aria-hidden');

    // Scroll fluide vers le formulaire (après la transition CSS)
    window.setTimeout(() => {
      formSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 120);
  }

  /**
   * Retour à la sélection : cache la section, nettoie l'état.
   */
  function resetSelection() {
    formSec.classList.remove('form-visible');
    formSec.setAttribute('aria-hidden', 'true');
    picker.classList.remove('services-picker--compact');
    cards.forEach((c) => c.classList.remove('svc-card--selected'));
    forms.forEach((f) => (f.hidden = true));
    window.setTimeout(() => {
      picker.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 120);
  }

  // Listeners cartes (clic + clavier)
  cards.forEach((card) => {
    const svc = card.dataset.service!;
    card.addEventListener('click', () => selectService(svc));
    card.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectService(svc);
      }
    });
  });

  // Listener bouton retour
  backBtn?.addEventListener('click', resetSelection);

  // Désactiver submit pendant envoi pour éviter les doublons
  forms.forEach((f) => {
    f.addEventListener('submit', () => {
      const btn = f.querySelector<HTMLButtonElement>('.devis-submit');
      if (btn) btn.disabled = true;
    });
  });

  /* ─────────────────────────────────────────────
     PRÉ-SÉLECTION VIA URL ?service=web|data|ia
  ───────────────────────────────────────────── */
  const params = new URLSearchParams(window.location.search);
  const svcParam = params.get('service');
  if (svcParam && ['web', 'data', 'ia'].includes(svcParam)) {
    // Léger délai pour laisser le layout se stabiliser
    window.setTimeout(() => selectService(svcParam), 50);
  }
</script>

