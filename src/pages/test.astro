---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Design Lab — Nal Consulting">

<div class="lab">

  <div class="lab-header">
    <div class="lab-header__badge">Design Lab · Usage interne</div>
    <h1>Visualisations & <span class="lab-gradient">Animations</span></h1>
    <p>Identifie les effets que tu veux intégrer au site.</p>
  </div>

  <!-- ══════════════════════════════════════════
       01 — COMPTEURS & STATS ANIMÉS
  ══════════════════════════════════════════ -->
  <section class="lab-section">
    <h2 class="lab-section__title">01 — Compteurs & Stats animés</h2>
    <div class="demo-grid demo-grid--4">

      <!-- Compteur simple -->
      <div class="demo-card">
        <div class="stat-big">
          <span class="counter" data-target="98">0</span><span class="stat-suffix">%</span>
        </div>
        <p class="stat-label">Clients satisfaits</p>
        <p class="demo-tag">Compteur rapide</p>
      </div>

      <!-- Compteur avec anneau -->
      <div class="demo-card">
        <div class="ring-wrap">
          <svg class="ring" viewBox="0 0 120 120">
            <circle class="ring__bg" cx="60" cy="60" r="50"/>
            <circle class="ring__fill" cx="60" cy="60" r="50" data-pct="87"/>
          </svg>
          <div class="ring__label"><span class="counter" data-target="87">0</span>%</div>
        </div>
        <p class="stat-label">Taux de réussite</p>
        <p class="demo-tag">Ring progress</p>
      </div>

      <!-- Stat avec tendance -->
      <div class="demo-card">
        <div class="trend-stat">
          <div class="trend-val"><span class="counter" data-target="2.4">0</span>M€</div>
          <div class="trend-badge trend-badge--up">↑ +34%</div>
        </div>
        <div class="spark-wrap" aria-hidden="true">
          <svg class="sparkline" viewBox="0 0 120 40">
            <polyline class="sparkline__line" points="0,35 20,28 40,22 60,30 80,14 100,8 120,3"/>
            <polyline class="sparkline__fill" points="0,35 20,28 40,22 60,30 80,14 100,8 120,3 120,40 0,40"/>
          </svg>
        </div>
        <p class="stat-label">Chiffre d'affaires</p>
        <p class="demo-tag">Stat + sparkline</p>
      </div>

      <!-- Compteur temps réel simulé -->
      <div class="demo-card">
        <div class="live-stat">
          <span class="live-dot" aria-hidden="true"></span>
          <span class="live-label">Live</span>
        </div>
        <div class="stat-big stat-big--live">
          <span id="liveCounter">1 247</span>
        </div>
        <p class="stat-label">Requêtes traitées</p>
        <p class="demo-tag">Compteur live</p>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       02 — GRAPHIQUES CSS ANIMÉS
  ══════════════════════════════════════════ -->
  <section class="lab-section">
    <h2 class="lab-section__title">02 — Graphiques CSS animés</h2>
    <div class="demo-grid demo-grid--3">

      <!-- Barres verticales -->
      <div class="demo-card demo-card--tall">
        <p class="demo-tag demo-tag--top">Bar chart CSS</p>
        <div class="bar-chart">
          <div class="bar-group">
            <div class="bar-col">
              <div class="bar" style="--h:72%; --c:#A0B4DE; --delay:0s"></div>
              <span class="bar-label">Jan</span>
            </div>
            <div class="bar-col">
              <div class="bar" style="--h:55%; --c:#6B91D4; --delay:.1s"></div>
              <span class="bar-label">Fév</span>
            </div>
            <div class="bar-col">
              <div class="bar" style="--h:88%; --c:#A0B4DE; --delay:.2s"></div>
              <span class="bar-label">Mar</span>
            </div>
            <div class="bar-col">
              <div class="bar" style="--h:64%; --c:#6B91D4; --delay:.3s"></div>
              <span class="bar-label">Avr</span>
            </div>
            <div class="bar-col">
              <div class="bar" style="--h:95%; --c:#4a70c0; --delay:.4s"></div>
              <span class="bar-label">Mai</span>
            </div>
            <div class="bar-col">
              <div class="bar" style="--h:78%; --c:#A0B4DE; --delay:.5s"></div>
              <span class="bar-label">Jun</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Graphique en ligne SVG animé -->
      <div class="demo-card demo-card--tall">
        <p class="demo-tag demo-tag--top">Line chart SVG</p>
        <div class="line-chart-wrap">
          <svg class="line-chart" viewBox="0 0 280 160" preserveAspectRatio="none">
            <defs>
              <linearGradient id="lineGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#6B91D4" stop-opacity=".35"/>
                <stop offset="100%" stop-color="#6B91D4" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <!-- Grille -->
            <line x1="0" y1="40"  x2="280" y2="40"  class="chart-grid"/>
            <line x1="0" y1="80"  x2="280" y2="80"  class="chart-grid"/>
            <line x1="0" y1="120" x2="280" y2="120" class="chart-grid"/>
            <!-- Aire remplie -->
            <path class="line-fill" d="M0,130 C40,120 60,90 90,75 S140,40 170,30 S230,15 280,10 V160 H0Z"/>
            <!-- Ligne principale -->
            <path class="line-path" d="M0,130 C40,120 60,90 90,75 S140,40 170,30 S230,15 280,10"/>
            <!-- Points -->
            <circle class="line-dot" cx="90"  cy="75" r="4"/>
            <circle class="line-dot" cx="170" cy="30" r="4"/>
            <circle class="line-dot" cx="280" cy="10" r="4"/>
          </svg>
          <div class="chart-axis">
            <span>Q1</span><span>Q2</span><span>Q3</span><span>Q4</span>
          </div>
        </div>
      </div>

      <!-- Donut multi-segments -->
      <div class="demo-card demo-card--tall">
        <p class="demo-tag demo-tag--top">Donut chart</p>
        <div class="donut-wrap">
          <svg class="donut" viewBox="0 0 120 120">
            <circle class="donut__seg" cx="60" cy="60" r="45"
                    style="--pct:45; --offset:0;   --color:#6B91D4"/>
            <circle class="donut__seg" cx="60" cy="60" r="45"
                    style="--pct:28; --offset:45;  --color:#A0B4DE"/>
            <circle class="donut__seg" cx="60" cy="60" r="45"
                    style="--pct:27; --offset:73;  --color:#4a70c0"/>
          </svg>
          <div class="donut__legend">
            <div class="legend-item"><span style="background:#6B91D4"></span>Web & SEO <b>45%</b></div>
            <div class="legend-item"><span style="background:#A0B4DE"></span>Data <b>28%</b></div>
            <div class="legend-item"><span style="background:#4a70c0"></span>IA <b>27%</b></div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       03 — BARRES DE PROGRESSION
  ══════════════════════════════════════════ -->
  <section class="lab-section">
    <h2 class="lab-section__title">03 — Barres de progression & compétences</h2>
    <div class="demo-grid demo-grid--2">

      <!-- Progress bars linéaires -->
      <div class="demo-card">
        <p class="demo-tag demo-tag--top">Progress bars animées</p>
        <div class="skills-list">
          {[
            { label: 'Python & Data Science', pct: 92, color: '#6B91D4' },
            { label: 'Power BI & Tableau',    pct: 88, color: '#A0B4DE' },
            { label: 'IA & LLMs',             pct: 85, color: '#4a70c0' },
            { label: 'Web & SEO',             pct: 78, color: '#6B91D4' },
            { label: 'Cloud & DevOps',        pct: 70, color: '#A0B4DE' },
          ].map(s => (
            <div class="skill-row">
              <div class="skill-meta">
                <span class="skill-name">{s.label}</span>
                <span class="skill-pct">{s.pct}%</span>
              </div>
              <div class="skill-bar">
                <div class="skill-fill" style={`--w:${s.pct}%; --c:${s.color}`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Hexagonal skill map -->
      <div class="demo-card">
        <p class="demo-tag demo-tag--top">Radar / badges compétences</p>
        <div class="badges-grid">
          {[
            { label: 'Python',     level: 5 },
            { label: 'SQL',        level: 5 },
            { label: 'Power BI',   level: 4 },
            { label: 'Machine Learning', level: 4 },
            { label: 'React',      level: 3 },
            { label: 'Docker',     level: 3 },
            { label: 'GPT API',    level: 5 },
            { label: 'Astro',      level: 4 },
          ].map(b => (
            <div class="skill-badge">
              <span class="skill-badge__name">{b.label}</span>
              <div class="skill-badge__dots">
                {Array.from({length:5}).map((_,i) => (
                  <div class={`dot ${i < b.level ? 'dot--on' : ''}`}></div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       04 — CARTES & LAYOUTS
  ══════════════════════════════════════════ -->
  <section class="lab-section">
    <h2 class="lab-section__title">04 — Cartes & layouts</h2>
    <div class="demo-grid demo-grid--3">

      <!-- Glassmorphism -->
      <div class="demo-card demo-card--dark">
        <p class="demo-tag demo-tag--light">Glassmorphism</p>
        <div class="glass-card">
          <div class="glass-card__icon">🚀</div>
          <h3 class="glass-card__title">Performance</h3>
          <p class="glass-card__desc">Site chargé en moins de 1s, score Lighthouse 99+</p>
          <div class="glass-card__footer">
            <span class="glass-pill">Core Web Vitals</span>
            <span class="glass-pill">SSG</span>
          </div>
        </div>
      </div>

      <!-- Bento grid -->
      <div class="demo-card">
        <p class="demo-tag demo-tag--top">Bento Grid</p>
        <div class="bento">
          <div class="bento__cell bento__cell--a">
            <span class="bento__ico">📊</span>
            <span class="bento__label">Analytics</span>
          </div>
          <div class="bento__cell bento__cell--b">
            <span class="bento__num counter" data-target="98">0</span>
            <span class="bento__label">NPS Score</span>
          </div>
          <div class="bento__cell bento__cell--c">
            <span class="bento__ico">🤖</span>
            <span class="bento__label">IA Agents</span>
          </div>
          <div class="bento__cell bento__cell--d">
            <span class="bento__label">Projets livrés</span>
            <span class="bento__big">50+</span>
          </div>
        </div>
      </div>

      <!-- Flip card -->
      <div class="demo-card">
        <p class="demo-tag demo-tag--top">Flip Card (hover)</p>
        <div class="flip-wrap">
          <div class="flip-card">
            <div class="flip-front">
              <div class="flip-icon">📈</div>
              <h3>Reporting</h3>
              <p>Data Analytics & BI</p>
            </div>
            <div class="flip-back">
              <h3>Ce qu'on fait</h3>
              <ul>
                <li>✓ Dashboards interactifs</li>
                <li>✓ KPIs en temps réel</li>
                <li>✓ Automatisation rapports</li>
              </ul>
              <a class="flip-cta">Voir l'offre →</a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       05 — ANIMATIONS DE TEXTE
  ══════════════════════════════════════════ -->
  <section class="lab-section">
    <h2 class="lab-section__title">05 — Animations de texte</h2>
    <div class="demo-grid demo-grid--3">

      <!-- Typewriter -->
      <div class="demo-card demo-card--center">
        <p class="demo-tag demo-tag--top">Typewriter</p>
        <div class="typewriter-wrap">
          <span class="typewriter" id="typewriter"></span><span class="cursor">|</span>
        </div>
      </div>

      <!-- Gradient shimmer text -->
      <div class="demo-card demo-card--dark demo-card--center">
        <p class="demo-tag demo-tag--light">Shimmer text</p>
        <h2 class="shimmer-text">Transformation<br/>Digitale</h2>
      </div>

      <!-- Word reveal -->
      <div class="demo-card demo-card--center">
        <p class="demo-tag demo-tag--top">Word reveal</p>
        <div class="word-reveal" id="wordReveal">
          <span>Nous</span>
          <span>créons</span>
          <span>votre</span>
          <span>avenir</span>
          <span>digital</span>
        </div>
      </div>

      <!-- Blur in -->
      <div class="demo-card demo-card--center">
        <p class="demo-tag demo-tag--top">Blur in</p>
        <p class="blur-text" id="blurText">Expertise. Précision. Résultats.</p>
        <button class="replay-btn" onclick="replayBlur()">↺ Rejouer</button>
      </div>

      <!-- Letter stagger -->
      <div class="demo-card demo-card--dark demo-card--center">
        <p class="demo-tag demo-tag--light">Letter stagger</p>
        <div class="stagger-text" id="staggerText">
          {"NAL CONSULTING".split('').map((l, i) => (
            <span style={`animation-delay:${i*0.05}s`}>{l === ' ' ? '\u00A0' : l}</span>
          ))}
        </div>
      </div>

      <!-- Compteur morphing -->
      <div class="demo-card demo-card--center">
        <p class="demo-tag demo-tag--top">Compteur morphing</p>
        <div class="morph-counter">
          <span class="morph-num" id="morphNum">0</span>
          <span class="morph-unit">projets</span>
        </div>
        <button class="replay-btn" onclick="replayMorph()">↺ Rejouer</button>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       06 — BOUTONS & MICRO-INTERACTIONS
  ══════════════════════════════════════════ -->
  <section class="lab-section">
    <h2 class="lab-section__title">06 — Boutons & micro-interactions</h2>
    <div class="demo-grid demo-grid--3">

      <div class="demo-card demo-card--center">
        <p class="demo-tag demo-tag--top">Gradient shimmer</p>
        <button class="btn-shimmer">Demander un devis</button>
      </div>

      <div class="demo-card demo-card--center">
        <p class="demo-tag demo-tag--top">Border draw</p>
        <button class="btn-border-draw">Découvrir</button>
      </div>

      <div class="demo-card demo-card--center">
        <p class="demo-tag demo-tag--top">Glow pulse</p>
        <button class="btn-glow">Contact</button>
      </div>

      <div class="demo-card demo-card--center">
        <p class="demo-tag demo-tag--top">Fill from left</p>
        <button class="btn-fill">En savoir plus</button>
      </div>

      <div class="demo-card demo-card--dark demo-card--center">
        <p class="demo-tag demo-tag--light">Liquid wave</p>
        <button class="btn-liquid">
          <span class="liquid-wave"></span>
          <span>Voir les services</span>
        </button>
      </div>

      <div class="demo-card demo-card--center">
        <p class="demo-tag demo-tag--top">Icon slide</p>
        <button class="btn-icon-slide">
          <span>Commencer</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       07 — FONDS & AMBIANCES
  ══════════════════════════════════════════ -->
  <section class="lab-section">
    <h2 class="lab-section__title">07 — Fonds & ambiances</h2>
    <div class="demo-grid demo-grid--2">

      <!-- Aurora -->
      <div class="demo-card demo-card--bg demo-card--dark">
        <div class="aurora" aria-hidden="true">
          <div class="aurora__blob aurora__blob--1"></div>
          <div class="aurora__blob aurora__blob--2"></div>
          <div class="aurora__blob aurora__blob--3"></div>
        </div>
        <div class="bg-label">Aurora Borealis</div>
      </div>

      <!-- Grille de points interactive -->
      <div class="demo-card demo-card--bg">
        <div class="dot-grid" aria-hidden="true" id="dotGrid"></div>
        <div class="bg-label bg-label--dark">Dot grid interactif</div>
      </div>

      <!-- Canvas particules -->
      <div class="demo-card demo-card--bg demo-card--dark">
        <canvas class="particle-canvas" id="particleCanvas"></canvas>
        <div class="bg-label">Réseau de particules</div>
      </div>

      <!-- Gradient animé avec border -->
      <div class="demo-card demo-card--bg">
        <div class="gradient-border-card">
          <div class="gradient-border-inner">
            <h3>Bordure gradient animée</h3>
            <p>Conic gradient rotatif sur la bordure</p>
          </div>
        </div>
        <div class="bg-label bg-label--dark">Animated gradient border</div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       08 — TIMELINE & PROCESSUS
  ══════════════════════════════════════════ -->
  <section class="lab-section">
    <h2 class="lab-section__title">08 — Timeline & processus</h2>
    <div class="demo-grid demo-grid--2">

      <!-- Timeline horizontale -->
      <div class="demo-card">
        <p class="demo-tag demo-tag--top">Timeline horizontale</p>
        <div class="h-timeline">
          {[
            { n: '01', t: 'Audit',      c: '#6B91D4' },
            { n: '02', t: 'Stratégie',  c: '#A0B4DE' },
            { n: '03', t: 'Livraison',  c: '#4a70c0' },
            { n: '04', t: 'Suivi',      c: '#6B91D4' },
          ].map((s, i) => (
            <div class="h-step" style={`--i:${i}; --c:${s.c}`}>
              <div class="h-step__node">{s.n}</div>
              {i < 3 && <div class="h-step__line"></div>}
              <div class="h-step__label">{s.t}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Steps avec icônes -->
      <div class="demo-card">
        <p class="demo-tag demo-tag--top">Steps numérotés</p>
        <div class="num-steps">
          {[
            { n: '1', t: 'Prise de contact', d: 'Échange de 30 min pour cerner vos besoins.' },
            { n: '2', t: 'Proposition',       d: 'Devis détaillé sous 48h.' },
            { n: '3', t: 'Livraison',         d: 'Itérations rapides, déploiement fluide.' },
          ].map((s, i) => (
            <div class="num-step" style={`--i:${i}`}>
              <div class="num-step__badge">{s.n}</div>
              <div class="num-step__body">
                <strong>{s.t}</strong>
                <p>{s.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

</div>

</MainLayout>

<script>
  /* ── COMPTEURS ── */
  const observeCounters = () => {
    const counters = document.querySelectorAll<HTMLElement>('.counter');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        const target = parseFloat(el.dataset.target ?? '0');
        const isDecimal = el.dataset.target?.includes('.');
        let cur = 0;
        const step = target / 50;
        const timer = setInterval(() => {
          cur = Math.min(cur + step, target);
          el.textContent = isDecimal ? cur.toFixed(1) : Math.round(cur).toString();
          if (cur >= target) clearInterval(timer);
        }, 25);
        obs.unobserve(el);
      });
    }, { threshold: 0.5 });
    counters.forEach(c => obs.observe(c));
  };
  observeCounters();

  /* ── RING PROGRESS ── */
  document.querySelectorAll<SVGCircleElement>('.ring__fill').forEach(circle => {
    const pct = parseFloat(circle.dataset.pct ?? '0');
    const r   = parseFloat(circle.getAttribute('r') ?? '50');
    const circ = 2 * Math.PI * r;
    circle.style.strokeDasharray  = `${circ}`;
    circle.style.strokeDashoffset = `${circ}`;
    const obs = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        setTimeout(() => {
          circle.style.strokeDashoffset = `${circ * (1 - pct / 100)}`;
        }, 200);
        obs.disconnect();
      }
    }, { threshold: 0.5 });
    obs.observe(circle);
  });

  /* ── DONUT ── */
  document.querySelectorAll<SVGCircleElement>('.donut__seg').forEach(seg => {
    const r    = 45;
    const circ = 2 * Math.PI * r;
    const pct    = parseFloat(getComputedStyle(seg).getPropertyValue('--pct'));
    const offset = parseFloat(getComputedStyle(seg).getPropertyValue('--offset'));
    seg.style.strokeDasharray  = `${circ * pct / 100} ${circ}`;
    seg.style.strokeDashoffset = `${circ * (1 - offset / 100)}`;
  });

  /* ── BARS ── */
  const barObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('bar--visible');
        barObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.bar').forEach(b => barObs.observe(b));

  /* ── SKILL BARS ── */
  const skillObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('skill-fill--visible');
        skillObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.skill-fill').forEach(s => skillObs.observe(s));

  /* ── TYPEWRITER ── */
  const words = ['sites web performants', 'dashboards interactifs', 'agents IA sur-mesure', 'votre croissance digitale'];
  let wIdx = 0, cIdx = 0, deleting = false;
  const tw = document.getElementById('typewriter');
  function typeStep() {
    if (!tw) return;
    const word = words[wIdx];
    if (!deleting) {
      tw.textContent = word.slice(0, ++cIdx);
      if (cIdx === word.length) { deleting = true; setTimeout(typeStep, 1800); return; }
    } else {
      tw.textContent = word.slice(0, --cIdx);
      if (cIdx === 0) { deleting = false; wIdx = (wIdx + 1) % words.length; }
    }
    setTimeout(typeStep, deleting ? 45 : 80);
  }
  typeStep();

  /* ── WORD REVEAL ── */
  const wordRevealObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('span').forEach((s, i) => {
          setTimeout(() => s.classList.add('revealed'), i * 120);
        });
        wordRevealObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  const wr = document.getElementById('wordReveal');
  if (wr) wordRevealObs.observe(wr);

  /* ── BLUR IN ── */
  const blurObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('blur-in');
        blurObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  const bt = document.getElementById('blurText');
  if (bt) blurObs.observe(bt);

  (window as any).replayBlur = () => {
    if (!bt) return;
    bt.classList.remove('blur-in');
    void (bt as HTMLElement).offsetWidth;
    bt.classList.add('blur-in');
  };

  /* ── STAGGER ── */
  const staggerObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('stagger-visible');
        staggerObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  const st = document.getElementById('staggerText');
  if (st) staggerObs.observe(st);

  /* ── MORPH COUNTER ── */
  let morphRunning = false;
  function runMorph() {
    const el = document.getElementById('morphNum');
    if (!el || morphRunning) return;
    morphRunning = true;
    let n = 0;
    const timer = setInterval(() => {
      n = Math.min(n + 1, 50);
      el.textContent = String(n);
      el.classList.add('morphing');
      setTimeout(() => el.classList.remove('morphing'), 120);
      if (n >= 50) { clearInterval(timer); morphRunning = false; }
    }, 40);
  }
  (window as any).replayMorph = () => { morphRunning = false; const el = document.getElementById('morphNum'); if(el) el.textContent = '0'; setTimeout(runMorph, 100); };
  const morphObs = new IntersectionObserver(e => { if (e[0].isIntersecting) runMorph(); }, { threshold: 0.5 });
  const mn = document.getElementById('morphNum');
  if (mn) morphObs.observe(mn);

  /* ── LIVE COUNTER ── */
  let liveVal = 1247;
  setInterval(() => {
    liveVal += Math.floor(Math.random() * 5) + 1;
    const el = document.getElementById('liveCounter');
    if (el) el.textContent = liveVal.toLocaleString('fr-FR');
  }, 800);

  /* ── PARTICLES CANVAS ── */
  const canvas = document.getElementById('particleCanvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const resize = () => { canvas.width = canvas.offsetWidth; canvas.height = canvas.offsetHeight; };
    resize();
    window.addEventListener('resize', resize);

    const particles: {x:number;y:number;vx:number;vy:number;r:number}[] = [];
    for (let i = 0; i < 55; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        r: Math.random() * 2 + 1,
      });
    }

    function drawParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width)  p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(160,180,222,.7)';
        ctx.fill();
      });
      particles.forEach((a, i) => {
        particles.slice(i + 1).forEach(b => {
          const dist = Math.hypot(a.x - b.x, a.y - b.y);
          if (dist < 80) {
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `rgba(160,180,222,${(1 - dist/80) * 0.4})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        });
      });
      requestAnimationFrame(drawParticles);
    }
    drawParticles();
  }

  /* ── DOT GRID ── */
  const grid = document.getElementById('dotGrid');
  if (grid) {
    const cols = 20, rows = 10;
    for (let i = 0; i < cols * rows; i++) {
      const dot = document.createElement('div');
      dot.className = 'gdot';
      dot.style.setProperty('--i', String(i));
      grid.appendChild(dot);
    }
    grid.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = grid.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      grid.querySelectorAll<HTMLElement>('.gdot').forEach(dot => {
        const dx = dot.offsetLeft - mx;
        const dy = dot.offsetTop  - my;
        const dist = Math.hypot(dx, dy);
        const scale = Math.max(0, 1 - dist / 80);
        dot.style.transform = `scale(${1 + scale * 2.5})`;
        dot.style.background = `rgba(107,145,212,${0.2 + scale * 0.8})`;
      });
    });
    grid.addEventListener('mouseleave', () => {
      grid.querySelectorAll<HTMLElement>('.gdot').forEach(dot => {
        dot.style.transform = '';
        dot.style.background = '';
      });
    });
  }

  /* ── STEPS ANIM ── */
  const stepsObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('step-visible');
        stepsObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.h-step, .num-step').forEach(s => stepsObs.observe(s));
</script>

