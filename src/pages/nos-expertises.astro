.sp-p { height: 6px; background: #d0d8e5; border-radius: 3px; }
.sp-p--short { width: 70%; }
.sp-btns { display: flex; gap: 0.4rem; margin-top: 0.3rem; }
.sp-btn { width: 50px; height: 18px; background: #e3e8f0; border-radius: 4px; }
.sp-btn--primary { background: var(--bleu-vif); }
.sp-hero-img { background: linear-gradient(135deg, #A0B4DE, #6B91D4); border-radius: 6px; min-height: 80px; }
.sp-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
.sp-card { height: 40px; background: var(--gris-clair); border-radius: 6px; border: 1px solid var(--gris-light); }

/* Mobile preview */
.mobile-preview { display: flex; justify-content: center; }
.mobile-frame {
  width: 140px;
  background: var(--gris-fonce);
  border-radius: 20px;
  padding: 6px;
  box-shadow: var(--shadow-md);
  position: relative;
}
.mobile-notch {
  width: 50px;
  height: 5px;
  background: #000;
  border-radius: 0 0 8px 8px;
  margin: 0 auto 4px;
}
.mobile-screen {
  background: var(--blanc);
  border-radius: 14px;
  padding: 0.7rem;
  min-height: 180px;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.ms-hero {
  height: 70px;
  background: linear-gradient(135deg, var(--bleu), var(--bleu-vif));
  border-radius: 8px;
}
.ms-content { display: flex; flex-direction: column; gap: 0.3rem; }
.ms-line { height: 6px; background: var(--gris-light); border-radius: 2px; }
.ms-line--short { width: 60%; }
.ms-btn { height: 16px; background: var(--bleu-vif); border-radius: 4px; margin-top: 0.3rem; }

/* ── Lighthouse big rings ── */
.lh-big-wrap {
  position: relative;
  padding: 1.8rem 1.5rem;
  background: linear-gradient(160deg, #ffffff 0%, #f7faff 100%);
  border-radius: var(--rayon-lg);
  border: 1px solid rgba(160, 180, 222, 0.25);
  box-shadow: 0 10px 40px rgba(107, 145, 212, 0.08);
  overflow: hidden;
}
.lh-big-wrap::before {
  content: '';
  position: absolute;
  top: -60px; right: -60px;
  width: 200px; height: 200px;
  background: radial-gradient(circle, rgba(107, 145, 212, 0.16), transparent 70%);
  pointer-events: none;
}
.lh-big-wrap::after {
  content: '';
  position: absolute;
  bottom: -80px; left: -60px;
  width: 240px; height: 240px;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.09), transparent 70%);
  pointer-events: none;
}
.lh-big-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.2rem;
  gap: 0.5rem;
  position: relative;
  z-index: 1;
}
.lh-big-title {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-weight: 700;
  color: var(--gris-moyen);
  margin: 0;
}
.lh-big-title::before {
  content: '';
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 10px #22c55e;
  animation: pulse-live 1.6s ease-in-out infinite;
}
.lh-big-badge {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.22rem 0.55rem;
  border-radius: 4px;
  background: rgba(34, 197, 94, 0.1);
  color: #22c55e;
  border: 1px solid rgba(34, 197, 94, 0.25);
}
.lh-big-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem 0.8rem;
  position: relative;
  z-index: 1;
}
.lh-big-ring-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 0.7rem 0.4rem;
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(160, 180, 222, 0.14);
  border-radius: var(--rayon);
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}
.lh-big-ring-wrap:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(107, 145, 212, 0.14);
}
.lh-big-ring { width: 100%; max-width: 100px; transform: rotate(-90deg); filter: drop-shadow(0 2px 8px rgba(34, 197, 94, 0.2)); }
.lh-big-ring__bg {
  fill: none;
  stroke: rgba(34, 197, 94, 0.14);
  stroke-width: 10;
}
.lh-big-ring__fill {
  fill: none;
  stroke: #22c55e;
  stroke-width: 10;
  stroke-linecap: round;
  transition: stroke-dashoffset 3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.lh-big-ring__num {
  fill: #22c55e;
  font-size: 2.1rem;
  font-weight: 800;
  text-anchor: middle;
  transform: rotate(90deg);
  transform-origin: 80px 80px;
}
.lh-big-ring__label {
  font-size: 0.78rem;
  color: var(--gris-fonce);
  font-weight: 600;
  text-align: center;
}

/* ══════════════════════════════════════════
   CAROUSEL CIRCULAIRE (coverflow 2D)
   ══════════════════════════════════════════ */
.circ-carousel-section {
  margin-top: 3rem;
  padding: 2rem 0;
}
.circ-carousel {
  position: relative;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 60px;
  user-select: none;
}
.circ-stage {
  position: relative;
  height: 230px;
  perspective: 1000px;
  overflow: visible;
}

.circ-card {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 260px;
  max-width: 75%;
  padding: 1.8rem 1.5rem;
  background: var(--blanc);
  border-radius: var(--rayon);
  border: 1px solid var(--gris-light);
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.6rem;
  transform: translate(-50%, -50%);
  transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  cursor: pointer;
}
.circ-card--active {
  box-shadow:
    0 0 0 1px rgba(107, 145, 212, 0.35),
    0 0 40px rgba(107, 145, 212, 0.45),
    0 20px 60px rgba(107, 145, 212, 0.25);
  border-color: var(--bleu-vif);
}
.circ-card--active::before {
  content: '';
  position: absolute;
  inset: -28px;
  border-radius: calc(var(--rayon) + 28px);
  background: radial-gradient(ellipse at center,
    rgba(107, 145, 212, 0.35) 0%,
    rgba(160, 180, 222, 0.18) 35%,
    transparent 70%);
  z-index: -1;
  pointer-events: none;
  animation: circ-glow-pulse 3s ease-in-out infinite;
}
@keyframes circ-glow-pulse {
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50%      { opacity: 1;   transform: scale(1.06); }
}
.circ-card__ico {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(160, 180, 222, 0.2), rgba(107, 145, 212, 0.1));
  color: var(--bleu-vif);
}
.circ-card__title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--gris-fonce);
}
.circ-card__desc {
  font-size: 0.88rem;
  color: var(--gris-moyen);
  line-height: 1.4;
}

/* Boutons prev/next */
.circ-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--blanc);
  border: 1px solid var(--gris-light);
  box-shadow: var(--shadow-sm);
  color: var(--gris-fonce);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.25s ease;
  z-index: 50;
}
.circ-nav:hover {
  background: var(--bleu-vif);
  color: var(--blanc);
  transform: translateY(-50%) scale(1.05);
}
.circ-nav--prev { left: 4px; }
.circ-nav--next { right: 4px; }

/* Dots */
.circ-dots {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 1.5rem;
}
.circ-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gris-light);
  border: none;
  cursor: pointer;
  transition: all 0.25s ease;
  padding: 0;
}
.circ-dot.active {
  background: var(--bleu-vif);
  width: 24px;
  border-radius: 4px;
}

/* Carousel Agents IA : cartes plus grandes */
.circ-carousel--agents .circ-stage { height: 280px; }
.circ-carousel--agents .circ-card {
  width: 320px;
  align-items: flex-start;
  text-align: left;
}

/* Agent card spéciales */
.circ-card--agent {
  padding-top: 2rem;
  overflow: hidden;
}
.agent-card__top-border {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: var(--accent);
  border-radius: var(--rayon) var(--rayon) 0 0;
}
.agent-card__header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  width: 100%;
  flex-wrap: wrap;
}
.agent-card__ico {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: color-mix(in srgb, var(--accent) 15%, transparent);
  color: var(--accent);
}
.agent-card__name {
  font-size: 1rem;
  font-weight: 700;
  color: var(--gris-fonce);
  flex: 1;
}
.agent-card__badge {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 700;
  padding: 0.25rem 0.6rem;
  border-radius: 999px;
  background: var(--gris-clair);
  color: var(--gris-moyen);
}
.agent-card__badge--data { background: rgba(107, 145, 212, 0.12); color: var(--bleu-vif); }
.agent-card__badge--ia   { background: rgba(74, 112, 192, 0.15); color: #4a70c0; }
.agent-card__badge--sales{ background: rgba(34, 197, 94, 0.12); color: #22c55e; }
.agent-card__desc {
  font-size: 0.88rem;
  color: var(--gris-moyen);
  line-height: 1.5;
  text-align: left;
}
.agent-card__gain {
  margin-top: auto;
  padding: 0.5rem 0.75rem;
  background: var(--gris-clair);
  border-radius: 8px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--gris-fonce);
  align-self: flex-start;
}

/* ══════════════════════════════════════════
   CHARTS (section Data)
   ══════════════════════════════════════════ */
.charts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  margin-bottom: 3rem;
}
.chart-card {
  background: var(--blanc);
  padding: 1.5rem;
  border-radius: var(--rayon);
  border: 1px solid var(--gris-light);
  box-shadow: var(--shadow-sm);
}
.chart-card:first-child  { grid-column: span 1; }
.chart-card:nth-child(2) { grid-column: span 1; }
.chart-card--line        { grid-column: span 2; }

.chart-card__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
  gap: 1rem;
}
.chart-card__title {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--gris-fonce);
}
.chart-card__sub {
  font-size: 0.78rem;
  color: var(--gris-moyen);
  margin-top: 0.2rem;
}

/* Badge LIVE */
.live-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #ef4444;
  text-transform: uppercase;
  padding: 0.2rem 0.5rem;
  background: rgba(239, 68, 68, 0.08);
  border-radius: 4px;
}
.live-dot {
  width: 6px;
  height: 6px;
  background: #ef4444;
  border-radius: 50%;
  animation: pulse-live 1.4s ease-in-out infinite;
}
@keyframes pulse-live {
  0%,100% { opacity: 1; transform: scale(1); }
  50%     { opacity: 0.4; transform: scale(1.3); }
}

/* Bar chart */
.bar-chart-wrap { height: 170px; }
.bar-chart-area {
  height: 100%;
  display: flex;
  align-items: flex-end;
}
.bc-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 0.5rem;
  width: 100%;
  height: 100%;
}
.bc-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.3rem;
  height: 100%;
}
.bc-bar {
  width: 70%;
  height: var(--h, 50%);
  background: linear-gradient(180deg, var(--bleu), var(--bleu-vif));
  border-radius: 6px 6px 0 0;
  transition: height 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.bc-month {
  font-size: 0.7rem;
  color: var(--gris-moyen);
  font-weight: 600;
}

/* ── Line chart (grande carte — viz avancée) ── */
.chart-legend-inline {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}
.chart-legend-inline__item {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--gris-moyen);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.cli-dash {
  display: inline-block;
  width: 18px;
  height: 3px;
  border-radius: 2px;
}
.cli-dash--before {
  background: repeating-linear-gradient(90deg, #cbd5e1 0 4px, transparent 4px 8px);
}
.cli-dash--after {
  background: var(--bleu-vif);
}

.line-chart-wrap {
  position: relative;
}
.line-chart-wrap--big {
  width: 100%;
  aspect-ratio: 720 / 280;
  max-height: 320px;
}
.lc-svg-v2 {
  width: 100%;
  height: 100%;
  display: block;
  overflow: visible;
}

/* Axes */
.lc-axis-line {
  stroke: rgba(148, 163, 184, 0.5);
  stroke-width: 1;
}
.lc-tick {
  stroke: rgba(148, 163, 184, 0.7);
  stroke-width: 1;
}
.lc-grid-line {
  stroke: rgba(203, 213, 225, 0.45);
  stroke-width: 1;
  stroke-dasharray: 3 5;
}
.lc-axis-label {
  fill: var(--gris-moyen);
  font-size: 11px;
  font-weight: 600;
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
}

/* Surfaces */
.lc-fill--before { fill: url(#lg2); }
.lc-fill--after  { fill: url(#lg1); }

/* Lignes */
.lc-line-v2 {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.lc-line--before {
  stroke: #94a3b8;
  stroke-width: 2;
  stroke-dasharray: 5 4;
}
.lc-line--after {
  stroke: var(--bleu-vif);
  stroke-width: 3;
  stroke-dasharray: 10 5;
  animation: dash-pulse 1.8s linear infinite;
  filter: drop-shadow(0 2px 8px rgba(107, 145, 212, 0.45));
}

/* Points AVANT (gris) */
.lc-dots--before circle {
  fill: #94a3b8;
  stroke: #fff;
  stroke-width: 1.5;
}

/* Points APRÈS (bleus, avec valeur au-dessus) */
.lc-dots--after circle {
  fill: var(--bleu-vif);
  stroke: #fff;
  stroke-width: 2;
}
.lc-point-val {
  fill: var(--bleu-vif);
  font-size: 11px;
  font-weight: 800;
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  letter-spacing: -0.01em;
}
.lc-point-val--last {
  fill: #fff;
  font-size: 13px;
}
.lc-point--last circle {
  fill: var(--bleu-vif);
  filter: drop-shadow(0 0 10px rgba(107, 145, 212, 0.9));
}

/* Pulse final */
.lc-pulse--ring {
  fill: none;
  stroke: var(--bleu-vif);
  stroke-width: 2;
  transform-origin: 700px 20px;
  animation: pulse-ring 1.6s ease-out infinite;
}
@keyframes pulse-ring {
  0%   { r: 6;  opacity: 0.85; }
  100% { r: 22; opacity: 0;    }
}
@keyframes dash-pulse {
  from { stroke-dashoffset: 0;   }
  to   { stroke-dashoffset: -30; }
}

/* ── Stats sous la courbe ── */
.lc-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 1.2rem;
  padding-top: 1.2rem;
  border-top: 1px solid var(--gris-light);
}
.lc-stat {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 0 0.6rem;
}
.lc-stat--sep {
  border-left: 1px solid var(--gris-light);
}
.lc-stat__num {
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--bleu-vif);
  line-height: 1;
  display: inline-flex;
  align-items: baseline;
}
.lc-stat__unit {
  font-size: 1.1rem;
  font-weight: 700;
  margin-left: 1px;
  color: var(--bleu-vif);
  opacity: 0.85;
}
.lc-stat__lbl {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--gris-moyen);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

/* Donut */
.donut-wrap {
  display: flex;
  align-items: center;
  gap: 2rem;
  justify-content: center;
}
.donut-chart-wrap { width: 160px; flex-shrink: 0; }
.donut-svg { width: 100%; transform: rotate(-90deg); }
.donut-rotate {
  transform-origin: 80px 80px;
  animation: donut-spin 40s linear infinite;
}
@keyframes donut-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
.dc-seg {
  fill: none;
  stroke: var(--col);
  stroke-width: 20;
  stroke-dasharray: calc(var(--pct) * 3.77) 377;
  stroke-dashoffset: calc(var(--off) * -3.77);
  transition: stroke-dasharray 0.9s ease, stroke-dashoffset 0.9s ease;
}
.dc-center-num {
  fill: var(--gris-fonce);
  font-size: 1.5rem;
  font-weight: 800;
  text-anchor: middle;
  transform: rotate(90deg);
  transform-origin: 80px 80px;
}
.dc-center-label {
  fill: var(--gris-moyen);
  font-size: 0.75rem;
  font-weight: 600;
  text-anchor: middle;
  transform: rotate(90deg);
  transform-origin: 80px 80px;
}
.donut-legend { display: flex; flex-direction: column; gap: 0.5rem; }
.dl-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.82rem;
  color: var(--gris-fonce);
  font-weight: 500;
}
.dl-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

/* ══════════════════════════════════════════
   SECTION IA — fond clair
   ══════════════════════════════════════════ */
.exp-section--ia {
  background: linear-gradient(180deg, var(--blanc) 0%, var(--gris-clair) 100%);
  border-radius: var(--rayon-lg);
  padding: 4rem 2rem 5rem;
  margin: 2rem 0;
}

/* Workflow */
.workflow-section {
  margin: 3rem 0;
  padding: 2rem 1rem;
  background: var(--blanc);
  border-radius: var(--rayon);
  border: 1px solid var(--gris-light);
}
.workflow-label {
  text-align: center;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-weight: 700;
  color: var(--gris-moyen);
  margin-bottom: 2rem;
}
.workflow-diagram { display: flex; flex-direction: column; gap: 2rem; }
.wf-row--main {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.wf-row--sub {
  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.wf-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  padding: 1rem;
  min-width: 130px;
  background: var(--blanc);
  border: 1px solid var(--gris-light);
  border-radius: var(--rayon);
  text-align: center;
  opacity: 0;
  transform: translateY(12px);
  transition: opacity 0.5s ease, transform 0.5s ease;
  position: relative;
}
.wf-node.wf-visible { opacity: 1; transform: translateY(0); }
.wf-node strong { font-size: 0.88rem; color: var(--gris-fonce); }
.wf-node span { font-size: 0.72rem; color: var(--gris-moyen); line-height: 1.4; }
.wf-node__ico {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: var(--gris-clair);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--bleu-vif);
}
.wf-node--agent {
  background: linear-gradient(135deg, rgba(160, 180, 222, 0.18), rgba(107, 145, 212, 0.12));
  border-color: var(--bleu);
}
.wf-node--agent .wf-node__ico {
  background: linear-gradient(135deg, var(--bleu), var(--bleu-vif));
  color: var(--blanc);
}
.wf-node__glow {
  position: absolute;
  inset: -6px;
  background: radial-gradient(circle, rgba(107, 145, 212, 0.3), transparent 70%);
