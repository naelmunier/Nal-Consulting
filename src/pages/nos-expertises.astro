---
import MainLayout from '../layouts/MainLayout.astro';

// Données features Web (section 1)
const webFeatures = [
  { title: 'Ultra-rapide',  desc: 'LCP < 1.2s',            svg: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>' },
  { title: 'Responsive',    desc: '50+ appareils',         svg: '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>' },
  { title: 'SEO technique', desc: 'Schema.org, balises OG',svg: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' },
  { title: 'Sécurisé',      desc: 'HTTPS, RGPD',           svg: '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>' },
  { title: 'Accessible',    desc: 'WCAG 2.1 AA',           svg: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>' },
  { title: 'CI/CD',         desc: 'Déploiement continu',   svg: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>' },
];

// Données features Data (section 2)
const dataFeatures = [
  { title: 'Temps réel',    desc: 'Données live',              svg: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' },
  { title: 'Connecté',      desc: 'Excel, SQL, API, ERP',      svg: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>' },
  { title: 'Multi-support', desc: 'Mobile, tablette, desktop', svg: '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>' },
  { title: 'Automatisé',    desc: 'Rapports planifiés',        svg: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>' },
  { title: 'Prédictif',     desc: 'Analyses ML',               svg: '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>' },
  { title: 'Alertes',       desc: 'KPIs seuil',                svg: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>' },
];

// Données agents IA (section 3)
const agents = [
  { name: 'Agent Email',       badge: 'Automation', badgeClass: '',                     accent: '#6B91D4', desc: 'Triage, classification et réponse automatique aux emails entrants. -90% de temps de traitement.', gain: '2 min vs 20 min par email',    svg: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>' },
  { name: 'Agent Reporting',   badge: 'Data',       badgeClass: 'agent-card__badge--data',accent: '#A0B4DE', desc: 'Connexion aux sources, extraction, mise en forme et envoi automatique chaque semaine.',       gain: 'Rapport hebdo en 30 secondes', svg: '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>' },
  { name: 'Agent Veille',      badge: 'IA',         badgeClass: 'agent-card__badge--ia',  accent: '#4a70c0', desc: 'Scan de 200+ sources, filtrage intelligent et synthèse quotidienne dans Slack ou Teams.',     gain: '5 min/jour au lieu de 3h',     svg: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' },
  { name: 'Agent Support',     badge: 'Customer',   badgeClass: '',                       accent: '#7c9ed8', desc: "Répond aux questions fréquentes 24h/24 en s'appuyant sur votre base de connaissances.",        gain: 'Disponible 24h/24 · 7j/7',     svg: '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>' },
  { name: 'Agent Prospection', badge: 'Sales',      badgeClass: 'agent-card__badge--sales',accent: '#5a80c8', desc: 'Enrichit votre CRM, rédige des messages personnalisés et qualifie les leads entrants.',     gain: '+40% de leads qualifiés',      svg: '<circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/>' },
];

// Lighthouse
const lhMetrics = [
  { label: 'Performance',    score: 98 },
  { label: 'Accessibilité',  score: 96 },
  { label: 'SEO',            score: 99 },
  { label: 'Best Practices', score: 92 },
];
---

<MainLayout title="Nos Expertises — Nal Consulting">

<!-- ═══ LAYOUT 2 COLONNES : TOC STICKY + CONTENU ═══ -->
<div class="exp-layout">

  <!-- ─── SIDEBAR TOC ─── -->
  <aside class="exp-toc" aria-label="Sommaire expertises">
    <p class="exp-toc__titre">Nos expertises</p>
    <nav class="exp-toc__nav">
      <a href="#web"  class="exp-toc__lien active" data-section="web">Sites &amp; SEO</a>
      <a href="#data" class="exp-toc__lien"        data-section="data">Analyse de données</a>
      <a href="#ia"   class="exp-toc__lien"        data-section="ia">Agents IA</a>
    </nav>
    <a href="/devis" class="btn btn--primaire exp-toc__cta">Démarrer un projet →</a>
  </aside>

  <!-- ─── CONTENU PRINCIPAL ─── -->
  <main class="exp-main">

    <!-- ═══ INTRO : Word-Reveal ═══ -->
    <section class="exp-intro" id="expIntro" aria-label="Introduction">
      <span class="eyebrow">Nos expertises</span>
      <h1 class="exp-intro__text">
        <span class="wr">Trois</span> <span class="wr">pôles.</span>
        <span class="wr">Un</span> <span class="wr">objectif :</span>
        <span class="wr wr--accent">transformer</span> <span class="wr">vos</span> <span class="wr">idées</span>
        <span class="wr">en</span> <span class="wr wr--accent">résultats</span> <span class="wr">mesurables.</span>
      </h1>
      <p class="exp-intro__sub">
        <span class="wr">Du</span> <span class="wr">site</span> <span class="wr">qui</span> <span class="wr">convertit</span>
        <span class="wr">au</span> <span class="wr">dashboard</span> <span class="wr">qui</span> <span class="wr">pilote,</span>
        <span class="wr">jusqu'à</span> <span class="wr">l'agent</span> <span class="wr">IA</span> <span class="wr">qui</span> <span class="wr">automatise.</span>
      </p>
    </section>

    <!-- ═══ SECTION 1 : SITES & SEO ═══ -->
    <section class="exp-section" id="web">
      <div class="web-two-col">

        <!-- Colonne gauche : Browser mockup -->
        <div class="browser-wrap">
          <div class="browser">
            <div class="browser__bar">
              <div class="browser__dots"><span></span><span></span><span></span></div>
              <div class="browser__url">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                nalconsulting.fr
              </div>
            </div>
            <div class="browser__content">
              <div class="site-preview">
                <div class="sp-nav">
                  <div class="sp-logo"></div>
                  <div class="sp-nav-links">
                    <div class="sp-link"></div><div class="sp-link"></div><div class="sp-link sp-link--active"></div>
                  </div>
                  <div class="sp-cta"></div>
                </div>
                <div class="sp-hero">
                  <div class="sp-hero-content">
                    <div class="sp-h1"></div><div class="sp-h1 sp-h1--short"></div>
                    <div class="sp-p"></div><div class="sp-p sp-p--short"></div>
                    <div class="sp-btns"><div class="sp-btn sp-btn--primary"></div><div class="sp-btn"></div></div>
                  </div>
                  <div class="sp-hero-img"></div>
                </div>
                <div class="sp-cards">
                  <div class="sp-card"></div><div class="sp-card"></div><div class="sp-card"></div>
                </div>
              </div>
            </div>
          </div>
          <div class="mobile-preview">
            <div class="mobile-frame">
              <div class="mobile-notch"></div>
              <div class="mobile-screen">
                <div class="ms-hero"></div>
                <div class="ms-content">
                  <div class="ms-line"></div><div class="ms-line ms-line--short"></div><div class="ms-btn"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Colonne droite -->
        <div class="web-right-col">
          <div class="web-heading">
            <span class="eyebrow">Expertise 01</span>
            <h2 class="web-titre">
              Sites Internet &amp; SEO<br/>
              <span class="grad-text">Référencement inclus.</span>
            </h2>
            <p class="sous-titre">Des sites conçus pour convertir — rapides, accessibles, premiers sur Google.</p>
          </div>

          <!-- Lighthouse rings BIG, grid 2x2 -->
          <div class="lh-big-wrap" id="lhWrap">
            <div class="lh-big-head">
              <p class="lh-big-title">Scores Lighthouse</p>
              <span class="lh-big-badge">Audit temps réel</span>
            </div>
            <div class="lh-big-grid">
              {lhMetrics.map(m => (
                <div class="lh-big-ring-wrap">
                  <svg class="lh-big-ring" viewBox="0 0 160 160">
                    <circle class="lh-big-ring__bg"   cx="80" cy="80" r="64"/>
                    <circle class="lh-big-ring__fill" cx="80" cy="80" r="64" data-score={m.score}/>
                    <text x="80" y="88" class="lh-big-ring__num" data-score={m.score}>0</text>
                  </svg>
                  <p class="lh-big-ring__label">{m.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Carousel circulaire features Web -->
      <div class="circ-carousel-section">
        <div class="circ-carousel" data-carousel="web">
          <button class="circ-nav circ-nav--prev" data-dir="prev" aria-label="Précédent">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="circ-stage">
            {webFeatures.map((f, i) => (
              <div class="circ-card" data-idx={i}>
                <span class="circ-card__ico" set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${f.svg}</svg>`}></span>
                <h4 class="circ-card__title">{f.title}</h4>
                <p class="circ-card__desc">{f.desc}</p>
              </div>
            ))}
          </div>
          <button class="circ-nav circ-nav--next" data-dir="next" aria-label="Suivant">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <div class="circ-dots">
            {webFeatures.map((_, i) => <button class={`circ-dot ${i===0 ? 'active' : ''}`} data-idx={i} aria-label={`Carte ${i+1}`}></button>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ SECTION 2 : DATA ═══ -->
    <section class="exp-section" id="data">
      <div class="exp-section-head">
        <span class="eyebrow">Expertise 02</span>
        <h2 class="exp-section-titre">
          Reporting &amp; Data Analytics<br/>
          <span class="grad-text">Vos données, enfin lisibles.</span>
        </h2>
        <p class="sous-titre">Des dashboards interactifs — décidez mieux, plus vite.</p>
      </div>

      <!-- Grid charts -->
      <div class="charts-grid" id="chartsGrid">

        <!-- Bar Chart -->
        <div class="chart-card">
          <div class="chart-card__header">
            <div>
              <p class="chart-card__title">Croissance mensuelle</p>
              <p class="chart-card__sub">Revenus 2024</p>
            </div>
            <div class="live-badge"><span class="live-dot"></span>LIVE</div>
          </div>
          <div class="bar-chart-wrap">
            <div class="bar-chart-area">
              <div class="bc-bars" id="bcBars">
                {[
                  { m:'Jan', h:48 },
                  { m:'Fév', h:60 },
                  { m:'Mar', h:54 },
                  { m:'Avr', h:74 },
                  { m:'Mai', h:87 },
                  { m:'Jun', h:98 },
                ].map((b) => (
                  <div class="bc-col">
                    <div class="bc-bar" style={`--h:${b.h}%`}></div>
                    <span class="bc-month">{b.m}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Donut Chart (petite carte) -->
        <div class="chart-card">
          <div class="chart-card__header">
            <div>
              <p class="chart-card__title">Répartition projets</p>
              <p class="chart-card__sub">Par type · 2024</p>
            </div>
            <div class="live-badge"><span class="live-dot"></span>LIVE</div>
          </div>
          <div class="donut-wrap">
            <div class="donut-chart-wrap">
              <svg class="donut-svg" viewBox="0 0 160 160" id="donutSvg">
                <g class="donut-rotate">
                  <circle class="dc-seg" cx="80" cy="80" r="60" style="--pct:42; --off:0;  --col:#6B91D4"/>
                  <circle class="dc-seg" cx="80" cy="80" r="60" style="--pct:33; --off:42; --col:#A0B4DE"/>
                  <circle class="dc-seg" cx="80" cy="80" r="60" style="--pct:25; --off:75; --col:#4a70c0"/>
                </g>
                <text x="80" y="75"  class="dc-center-num">50+</text>
                <text x="80" y="92"  class="dc-center-label">projets</text>
              </svg>
            </div>
            <div class="donut-legend">
              <div class="dl-item"><span class="dl-dot" style="background:#6B91D4"></span>Power BI</div>
              <div class="dl-item"><span class="dl-dot" style="background:#A0B4DE"></span>Python</div>
              <div class="dl-item"><span class="dl-dot" style="background:#4a70c0"></span>Rapports auto</div>
            </div>
          </div>
        </div>

        <!-- Line Chart (grande carte — visualisation avancée) -->
        <div class="chart-card chart-card--line">
          <div class="chart-card__header">
            <div>
              <p class="chart-card__title">Performance opérationnelle</p>
              <p class="chart-card__sub">Indice composite · Avant / après BI</p>
            </div>
            <div class="chart-legend-inline">
              <span class="chart-legend-inline__item"><span class="cli-dash cli-dash--before"></span>Avant</span>
              <span class="chart-legend-inline__item"><span class="cli-dash cli-dash--after"></span>Après</span>
              <div class="live-badge"><span class="live-dot"></span>LIVE</div>
            </div>
          </div>

          <div class="line-chart-wrap line-chart-wrap--big">
            <svg class="lc-svg-v2" viewBox="0 0 720 280" role="img" aria-label="Courbe de performance avant/après BI">
              <defs>
                <linearGradient id="lg1" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%"  stop-color="#6B91D4" stop-opacity=".45"/>
                  <stop offset="100%" stop-color="#6B91D4" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="lg2" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%"  stop-color="#cbd5e1" stop-opacity=".22"/>
                  <stop offset="100%" stop-color="#cbd5e1" stop-opacity="0"/>
                </linearGradient>
              </defs>

              <!-- Axe Y : graduations + labels -->
              <g class="lc-axis-y">
                <line class="lc-axis-line" x1="60" y1="20" x2="60" y2="240"/>
                {[0, 25, 50, 75, 100].map((v, i) => {
                  const y = 240 - (v * 2.2);
                  return (
                    <g>
                      <line class="lc-grid-line" x1="60" y1={y} x2="700" y2={y}/>
                      <line class="lc-tick" x1="56" y1={y} x2="60" y2={y}/>
                      <text class="lc-axis-label" x="48" y={y + 4} text-anchor="end">{v}</text>
                    </g>
                  );
                })}
              </g>

              <!-- Axe X -->
              <g class="lc-axis-x">
                <line class="lc-axis-line" x1="60" y1="240" x2="700" y2="240"/>
                {['Jan','Fév','Mar','Avr','Mai','Jun','Jul'].map((m, i) => {
                  const x = 60 + (640 / 6) * i;
                  return (
                    <g>
                      <line class="lc-tick" x1={x} y1="240" x2={x} y2="244"/>
                      <text class="lc-axis-label" x={x} y="262" text-anchor="middle">{m}</text>
                    </g>
                  );
                })}
              </g>

              <!-- Surface AVANT (grise) -->
              <path class="lc-fill lc-fill--before"
                d="M60,207 C156,203 252,199 348,196 S540,192 604,189 S668,187 700,185 L700,240 L60,240 Z"/>

              <!-- Surface APRÈS (bleue) -->
              <path class="lc-fill lc-fill--after"
                d="M60,210 C160,180 220,140 300,110 S420,55 500,45 S640,25 700,20 L700,240 L60,240 Z"/>

              <!-- Ligne AVANT (tirets) -->
              <path class="lc-line-v2 lc-line--before"
                d="M60,207 C156,203 252,199 348,196 S540,192 604,189 S668,187 700,185"/>

              <!-- Ligne APRÈS (pleine, animée) -->
              <path class="lc-line-v2 lc-line--after"
                d="M60,210 C160,180 220,140 300,110 S420,55 500,45 S640,25 700,20"/>

              <!-- Points de données AVANT -->
              <g class="lc-dots lc-dots--before">
                <circle cx="60"   cy="207" r="3"/>
                <circle cx="167"  cy="202" r="3"/>
                <circle cx="273"  cy="198" r="3"/>
                <circle cx="380"  cy="194" r="3"/>
                <circle cx="487"  cy="191" r="3"/>
                <circle cx="593"  cy="188" r="3"/>
                <circle cx="700"  cy="185" r="3"/>
              </g>

              <!-- Points de données APRÈS — avec valeurs -->
              <g class="lc-dots lc-dots--after">
                <g class="lc-point">
                  <circle cx="60"  cy="210" r="4.5"/>
                  <text class="lc-point-val" x="60" y="194" text-anchor="middle">14</text>
                </g>
                <g class="lc-point">
                  <circle cx="167" cy="170" r="4.5"/>
                  <text class="lc-point-val" x="167" y="154" text-anchor="middle">32</text>
                </g>
                <g class="lc-point">
                  <circle cx="273" cy="118" r="4.5"/>
                  <text class="lc-point-val" x="273" y="102" text-anchor="middle">55</text>
                </g>
                <g class="lc-point">
                  <circle cx="380" cy="85"  r="4.5"/>
                  <text class="lc-point-val" x="380" y="69" text-anchor="middle">70</text>
                </g>
                <g class="lc-point">
                  <circle cx="487" cy="55"  r="4.5"/>
                  <text class="lc-point-val" x="487" y="39" text-anchor="middle">84</text>
                </g>
                <g class="lc-point">
                  <circle cx="593" cy="35"  r="4.5"/>
                  <text class="lc-point-val" x="593" y="19" text-anchor="middle">93</text>
                </g>
                <g class="lc-point lc-point--last">
                  <circle cx="700" cy="20"  r="5.5"/>
                  <text class="lc-point-val lc-point-val--last" x="692" y="14" text-anchor="end">98</text>
                </g>
              </g>

              <!-- Anneau pulse sur point final -->
              <circle class="lc-pulse lc-pulse--ring" cx="700" cy="20" r="6"/>
            </svg>
          </div>

          <!-- Stats inline -->
          <div class="lc-stats">
            <div class="lc-stat">
              <span class="lc-stat__num">×3.8</span>
              <span class="lc-stat__lbl">Vitesse de décision</span>
            </div>
            <div class="lc-stat lc-stat--sep">
              <span class="lc-stat__num">−72<span class="lc-stat__unit">%</span></span>
              <span class="lc-stat__lbl">Temps de reporting</span>
            </div>
            <div class="lc-stat lc-stat--sep">
              <span class="lc-stat__num">+62<span class="lc-stat__unit">%</span></span>
              <span class="lc-stat__lbl">Gain opérationnel</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Carousel circulaire features Data -->
      <div class="circ-carousel-section">
        <div class="circ-carousel" data-carousel="data">
          <button class="circ-nav circ-nav--prev" data-dir="prev" aria-label="Précédent">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="circ-stage">
            {dataFeatures.map((f, i) => (
              <div class="circ-card" data-idx={i}>
                <span class="circ-card__ico" set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${f.svg}</svg>`}></span>
                <h4 class="circ-card__title">{f.title}</h4>
                <p class="circ-card__desc">{f.desc}</p>
              </div>
            ))}
          </div>
          <button class="circ-nav circ-nav--next" data-dir="next" aria-label="Suivant">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <div class="circ-dots">
            {dataFeatures.map((_, i) => <button class={`circ-dot ${i===0 ? 'active' : ''}`} data-idx={i} aria-label={`Carte ${i+1}`}></button>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ SECTION 3 : IA (fond clair) ═══ -->
    <section class="exp-section exp-section--ia" id="ia">
      <div class="exp-section-head">
        <span class="eyebrow">Expertise 03</span>
        <h2 class="exp-section-titre">
          Automatisations &amp; Agents IA<br/>
          <span class="grad-text">Vos process automatisés.</span>
        </h2>
        <p class="sous-titre">Des agents intelligents opérationnels 24h/24 — du simple workflow à l'orchestration multi-agents.</p>
      </div>

      <!-- Workflow diagram -->
      <div class="workflow-section">
