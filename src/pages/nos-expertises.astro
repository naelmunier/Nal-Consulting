<script>
/* ═══ TOC STICKY — lien actif via IntersectionObserver ═══ */
(function() {
  const liens = document.querySelectorAll<HTMLAnchorElement>('.exp-toc__lien');
  const sections = ['web','data','ia']
    .map(id => document.getElementById(id))
    .filter((s): s is HTMLElement => s !== null);

  if (sections.length === 0) return;

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        liens.forEach(l => l.classList.toggle('active', l.dataset.section === id));
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });

  sections.forEach(s => obs.observe(s));

  /* Smooth scroll au clic */
  liens.forEach(lien => {
    lien.addEventListener('click', (e) => {
      e.preventDefault();
      const id = lien.getAttribute('href')?.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (target) {
        const offset = 80;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    });
  });
})();

/* ═══ LIGHTHOUSE RINGS — stroke-dasharray anim + counter up ═══ */
(function() {
  const wrap = document.getElementById('lhWrap');
  if (!wrap) return;

  const rings = wrap.querySelectorAll<SVGCircleElement>('.lh-big-ring__fill');
  const nums  = wrap.querySelectorAll<SVGTextElement>('.lh-big-ring__num');
  const r = 64;
  const circ = 2 * Math.PI * r; /* ≈ 402.12 */

  /* Init : stroke-dasharray/offset à 0% */
  rings.forEach(ring => {
    ring.style.strokeDasharray = `${circ}`;
    ring.style.strokeDashoffset = `${circ}`;
  });

  function easeOutCubic(t: number) { return 1 - Math.pow(1 - t, 3); }

  function animateCounter(el: SVGTextElement, target: number, duration = 3000) {
    const start = performance.now();
    function tick(now: number) {
      const elapsed = now - start;
      const t = Math.min(1, elapsed / duration);
      const val = Math.round(easeOutCubic(t) * target);
      el.textContent = String(val);
      if (t < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  let triggered = false;
  const obs = new IntersectionObserver((entries) => {
    if (triggered) return;
    if (entries[0].isIntersecting && entries[0].intersectionRatio >= 0.4) {
      triggered = true;
      rings.forEach(ring => {
        const score = parseFloat(ring.dataset.score || '0');
        ring.classList.add('lh-big-ring--animate');
        /* Offset final : circ - (score/100 * circ) */
        ring.style.strokeDashoffset = `${circ - (score / 100) * circ}`;
      });
      nums.forEach(num => {
        const score = parseFloat(num.dataset.score || '0');
        animateCounter(num, score);
      });
      obs.disconnect();
    }
  }, { threshold: 0.4 });

  obs.observe(wrap);
})();

/* ═══ CAROUSELS CIRCULAIRES (coverflow 2D) ═══ */
(function() {
  class CircCarousel {
    el: HTMLElement;
    cards: HTMLElement[];
    dots: HTMLElement[];
    prevBtn: HTMLElement | null;
    nextBtn: HTMLElement | null;
    current: number;
    total: number;
    autoTimer: ReturnType<typeof setInterval> | null;
    paused: boolean;

    constructor(el: HTMLElement) {
      this.el = el;
      this.cards = Array.from(el.querySelectorAll<HTMLElement>('.circ-card'));
      this.dots  = Array.from(el.querySelectorAll<HTMLElement>('.circ-dot'));
      this.prevBtn = el.querySelector<HTMLElement>('.circ-nav--prev');
      this.nextBtn = el.querySelector<HTMLElement>('.circ-nav--next');
      this.current = 0;
      this.total = this.cards.length;
      this.autoTimer = null;
      this.paused = false;

      this.bind();
      this.update();
      this.startAuto();
    }

    bind() {
      if (this.prevBtn) this.prevBtn.addEventListener('click', () => { this.go(this.current - 1); this.resetAuto(); });
      if (this.nextBtn) this.nextBtn.addEventListener('click', () => { this.go(this.current + 1); this.resetAuto(); });
      this.dots.forEach((dot, i) => dot.addEventListener('click', () => { this.go(i); this.resetAuto(); }));
      this.cards.forEach((card, i) => card.addEventListener('click', () => {
        if (i !== this.current) { this.go(i); this.resetAuto(); }
      }));
      this.el.addEventListener('mouseenter', () => { this.paused = true; });
      this.el.addEventListener('mouseleave', () => { this.paused = false; });
    }

    go(idx: number) {
      this.current = ((idx % this.total) + this.total) % this.total;
      this.update();
    }

    update() {
      this.cards.forEach((card, i) => {
        let diff = i - this.current;
        /* Enroulement pour carousel circulaire */
        if (diff > this.total / 2)  diff -= this.total;
        if (diff < -this.total / 2) diff += this.total;

        const abs = Math.abs(diff);
        let scale = 1, opacity = 1, translate = 0, z = 10;

        if (diff === 0) {
          scale = 1; opacity = 1; translate = 0; z = 30;
        } else if (abs === 1) {
          scale = 0.78; opacity = 0.5; translate = diff * 78; z = 20;
        } else if (abs === 2) {
          scale = 0.6; opacity = 0.22; translate = diff * 62; z = 10;
        } else {
          scale = 0.45; opacity = 0; translate = diff * 48; z = 1;
        }

        card.style.transform = `translate(-50%, -50%) translateX(${translate}%) scale(${scale})`;
        card.style.opacity = String(opacity);
        card.style.zIndex = String(z);
        card.classList.toggle('circ-card--active', diff === 0);
        card.style.pointerEvents = abs > 2 ? 'none' : 'auto';
      });
      this.dots.forEach((dot, i) => dot.classList.toggle('active', i === this.current));
    }

    startAuto() {
      this.autoTimer = setInterval(() => {
        if (!this.paused) this.go(this.current + 1);
      }, 2200);
    }

    resetAuto() {
      if (this.autoTimer) clearInterval(this.autoTimer);
      this.startAuto();
    }
  }

  document.querySelectorAll<HTMLElement>('.circ-carousel').forEach(el => new CircCarousel(el));
})();

/* ═══ CHARTS : barres anim continue + line dash pulse (donut anim CSS) ═══ */
(function() {
  const bars = document.querySelectorAll<HTMLElement>('.bc-bar');
  if (bars.length === 0) return;

  function randomize() {
    bars.forEach(bar => {
      const h = Math.round(40 + Math.random() * 60); /* 40-100 */
      bar.style.setProperty('--h', `${h}%`);
    });
  }

  /* Déclenchement au scroll puis interval */
  const dataSection = document.getElementById('data');
  let started = false;
  if (dataSection) {
    const obs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting && !started) {
        started = true;
        setTimeout(randomize, 300);
        setInterval(randomize, 3000);
        obs.disconnect();
      }
    }, { threshold: 0.15 });
    obs.observe(dataSection);
  }
})();

/* ═══ WORD-REVEAL intro (cascade mot-à-mot) ═══ */
(function() {
  const intro = document.getElementById('expIntro');
  if (!intro) return;
  const words = Array.from(intro.querySelectorAll<HTMLElement>('.wr'));
  let triggered = false;

  const obs = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !triggered) {
      triggered = true;
      words.forEach((w, i) => {
        setTimeout(() => w.classList.add('is-visible'), i * 70);
      });
      obs.disconnect();
    }
  }, { threshold: 0.3 });
  obs.observe(intro);
})();

/* ═══ WORKFLOW (section IA) — reveal au scroll ═══ */
(function() {
  const iaSection = document.getElementById('ia');
  let triggered = false;
  if (!iaSection) return;

  const obs = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !triggered) {
      triggered = true;
      document.querySelectorAll<HTMLElement>('.wf-node, .wf-arrow, .wf-sub-node').forEach((el, i) => {
        setTimeout(() => el.classList.add('wf-visible'), i * 140);
      });
      obs.disconnect();
    }
  }, { threshold: 0.15 });
  obs.observe(iaSection);
})();
</script>

