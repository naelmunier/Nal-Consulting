---
import { translations } from '../i18n/translations';
const t  = translations.fr;
const tf = t.footer;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__body">
    <div class="container">
      <div class="footer__grid">

        <!-- Marque -->
        <div class="footer__brand">
          <a href="/" aria-label="Nal Consulting">
            <img src="/assets/logo.png" alt="Nal Consulting" height="36" />
          </a>
          <p class="footer__brand-desc" data-i18n="footer.desc">{tf.desc}</p>
          <div class="footer__socials">
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="footer__social" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="footer__social" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Services -->
        <div class="footer__col">
          <h3 class="footer__col-title" data-i18n="footer.services">{tf.services}</h3>
          <ul class="footer__links">
            <li><a href="/devis?service=web"  data-i18n="services.items.0.title">Sites internet & SEO</a></li>
            <li><a href="/devis?service=data" data-i18n="services.items.1.title">Reporting & Data Analytics</a></li>
            <li><a href="/devis?service=ia"   data-i18n="services.items.2.title">Automatisations & Agents IA</a></li>
          </ul>
        </div>

        <!-- Navigation -->
        <div class="footer__col">
          <h3 class="footer__col-title" data-i18n="footer.nav">{tf.nav}</h3>
          <ul class="footer__links">
            <li><a href="/"                data-i18n="nav.home">Accueil</a></li>
            <li><a href="/qui-sommes-nous" data-i18n="nav.about">Qui sommes-nous</a></li>
            <li><a href="/devis"           data-i18n="nav.quote">Devis</a></li>
            <li><a href="/contact"         data-i18n="nav.contact">Contact</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div class="footer__col">
          <h3 class="footer__col-title" data-i18n="footer.contact">{tf.contact}</h3>
          <ul class="footer__links footer__links--info">
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <a href="mailto:contact@nalconsulting.fr" data-i18n="contact.emailVal">contact@nalconsulting.fr</a>
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span data-i18n="contact.locVal">France</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Bas -->
      <div class="footer__bottom">
        <p class="footer__copy">© {year} Nal Consulting. <span data-i18n="footer.copy">{tf.copy}</span></p>
        <div class="footer__bottom-links">
          <a href="/mentions-legales" data-i18n="footer.legal">{tf.legal}</a>
          <a href="/politique-confidentialite" data-i18n="footer.privacy">{tf.privacy}</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
.footer { position:relative; background:var(--blanc); }

.footer__body {
  background:var(--bleu-nuit);
  padding:4rem 0 2.5rem;
}

.footer__grid {
  display:grid; grid-template-columns:2fr 1fr 1fr 1.3fr;
  gap:3rem; margin-bottom:3.5rem;
}

/* Brand */
.footer__brand img {
  height:36px; width:auto; border-radius:0; margin-bottom:1.1rem; display:block;
}
.footer__brand-desc {
  font-size:.88rem; color:rgba(255,255,255,.48);
  line-height:1.72; max-width:250px; margin-bottom:1.4rem;
}
.footer__socials { display:flex; gap:.65rem; }
.footer__social {
  display:flex; align-items:center; justify-content:center;
  width:38px; height:38px; border-radius:50%;
  background:rgba(160,180,222,.08);
  color:rgba(255,255,255,.55);
  border:1px solid rgba(160,180,222,.14);
  transition:background .2s, color .2s, border-color .2s;
}
.footer__social:hover { background:var(--bleu); color:var(--bleu-nuit); border-color:var(--bleu); }

/* Cols */
.footer__col-title {
  font-size:.72rem; font-weight:700; text-transform:uppercase;
  letter-spacing:.14em; color:rgba(255,255,255,.35); margin-bottom:1.1rem;
}
.footer__links { list-style:none; display:flex; flex-direction:column; gap:.65rem; }
.footer__links a {
  font-size:.88rem; color:rgba(255,255,255,.58); transition:color .2s;
}
.footer__links a:hover { color:var(--bleu-clair); }

.footer__links--info li {
  display:flex; align-items:center; gap:.6rem;
  font-size:.88rem; color:rgba(255,255,255,.58);
}
.footer__links--info svg { color:var(--bleu); flex-shrink:0; }

/* Bottom */
.footer__bottom {
  display:flex; align-items:center; justify-content:space-between;
  padding-top:1.8rem;
  border-top:1px solid rgba(255,255,255,.06);
  gap:1rem; flex-wrap:wrap;
}
.footer__copy { font-size:.82rem; color:rgba(255,255,255,.3); }
.footer__bottom-links { display:flex; gap:1.4rem; }
.footer__bottom-links a {
  font-size:.82rem; color:rgba(255,255,255,.3); transition:color .2s;
}
.footer__bottom-links a:hover { color:rgba(255,255,255,.65); }

/* Responsive */
@media (max-width:900px) {
  .footer__grid { grid-template-columns:1fr 1fr; gap:2.5rem; }
  .footer__brand { grid-column:1 / -1; }
}
@media (max-width:600px) {
  .footer__grid { grid-template-columns:1fr; gap:2rem; }
  .footer__bottom { flex-direction:column; align-items:flex-start; }
}
</style>
